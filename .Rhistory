moda <- function(x) {
tab <- table(x)
maxfreq <- max(tab)
as.numeric(names(tab)[tab == maxfreq])
}
modas <- moda(libros)
modas
cat("Media:", mean(libros), "\n")
cat("Varianza (muestral):", var(libros), "\n")
cat("Desv. estándar (muestral):", sd(libros), "\n")
cat("Rango:", max(libros) - min(libros), "\n")
cat("Mediana:", median(libros), "\n")
cat("Moda(s):", paste(moda(libros), collapse = ", "), "\n")
