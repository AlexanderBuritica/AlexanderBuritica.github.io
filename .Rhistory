library(ggplot2)
library(scales)
# --- Verified estimates from Buriticá Casanova & González (2026), footnote 6 ---
# Control mean 2016 price = 6,596 COP/kg
# DiD effects: +1,657 (training only), +2,710 (training + cupping)
df <- data.frame(
group = factor(
c("No support\n(control)", "Training\nonly", "Training +\ncupping"),
levels = c("No support\n(control)", "Training\nonly", "Training +\ncupping")),
price = c(6596, 8253, 9306),
label = c("baseline", "+25%", "+41%")
)
greys <- c("#D6D6D6", "#969696", "#525252")   # light -> dark grayscale
txt   <- c("#4d4d4d", "white", "white")
ggplot(df, aes(group, price, fill = group)) +
geom_col(width = 0.56, colour = "white", linewidth = 0.4) +
geom_hline(yintercept = 6596, colour = "#8C8C8C",
linetype = "22", linewidth = 0.5, lineend = "round") +
geom_text(aes(label = label, y = price + 250),
fontface = "bold", size = 4.9, colour = "#2b2b2b") +
geom_text(aes(label = comma(price), y = price - 560),
colour = txt, fontface = "bold", size = 3.7) +
geom_text(aes(label = "COP/kg", y = price - 880), colour = txt, size = 3.0) +
scale_fill_manual(values = greys, guide = "none") +
scale_y_continuous(limits = c(0, 11000), breaks = seq(0, 10000, 2000), labels = comma) +
labs(
title = "Training and cupping raised the price farmers received",
subtitle = "Average farmgate price by group, from difference-in-differences estimates.",
x = NULL, y = "Farmgate price received, 2016 (COP per kg)") +
theme_minimal(base_size = 12) +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor   = element_blank(),
panel.grid.major.y = element_line(colour = "#EEEEEE"),
axis.ticks = element_blank(),
plot.title    = element_text(face = "bold", size = 14, colour = "#222222"),
plot.subtitle = element_text(size = 10, colour = "#6f6f6f"),
axis.title.y  = element_text(size = 11, colour = "#333333"),
axis.text     = element_text(colour = "#333333"))
ggsave("Figure_price_impact.png", width = 7.6, height = 5.4, dpi = 300, bg = "white")
