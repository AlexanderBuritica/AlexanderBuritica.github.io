library(sf)
library(dplyr)
library(tmap)
library(rnaturalearth)
library(rnaturalearthdata)
tmap_mode("plot")
# =====================================================
# ESTILO
# =====================================================
cluster_cols   <- c("black", "grey45", "white")
cluster_shapes <- c(16, 17, 22)
cluster_labs   <- c(
"Cluster 1",
"Cluster 2",
"Cluster 3"
)
# =====================================================
# BOUNDING BOX DEL ZOOM
# =====================================================
bb_zoom <- st_bbox(
c(
xmin = -76.5,
xmax = -75.0,
ymin =  3.5,
ymax =  5.5
),
crs = st_crs(df_sf)
)
zoom_box <- st_as_sfc(bb_zoom)
# =====================================================
# MAPA PRINCIPAL
# =====================================================
map_main <-
tm_shape(colombia) +
tm_polygons(
col = "grey96",
border.col = "grey70",
lwd = 0.3
) +
tm_shape(departments) +
tm_borders(
col = "grey90",
lwd = 0.25
) +
# caja del zoom
tm_shape(zoom_box) +
tm_borders(
col = "black",
lwd = 1,
lty = "dashed"
) +
tm_shape(df_sf) +
tm_symbols(
col     = "cluster_label",
shape   = "cluster_label",
palette = cluster_cols,
shapes  = cluster_shapes,
size = 0.18,
border.col = "black",
border.lwd = 0.35,
legend.col.show   = FALSE,
legend.shape.show = FALSE
) +
tm_add_legend(
type   = "symbol",
col    = cluster_cols,
shape  = cluster_shapes,
labels = cluster_labs,
title  = "Exposure cluster"
) +
tm_layout(
title = "Coffee farms by exposure cluster",
title.size = 1.0,
title.fontface = "bold",
bg.color = "white",
frame = FALSE,
legend.position = c("left", "bottom"),
legend.title.size = 0.8,
legend.text.size  = 0.7,
inner.margins = c(0.03, 0.03, 0.08, 0.03)
)
# =====================================================
# MAPA ZOOM
# =====================================================
map_zoom <-
tm_shape(colombia, bbox = bb_zoom) +
tm_polygons(
col = "grey97",
border.col = "grey80",
lwd = 0.25
) +
tm_shape(departments, bbox = bb_zoom) +
tm_borders(
col = "grey88",
lwd = 0.2
) +
tm_shape(df_sf, bbox = bb_zoom) +
tm_symbols(
col     = "cluster_label",
shape   = "cluster_label",
palette = cluster_cols,
shapes  = cluster_shapes,
size = 0.28,
border.col = "black",
border.lwd = 0.4,
legend.col.show   = FALSE,
legend.shape.show = FALSE
) +
tm_layout(
title = "Main coffee belt",
title.size = 0.9,
bg.color = "white",
frame = TRUE,
frame.lwd = 0.5,
inner.margins = c(0.02, 0.02, 0.02, 0.02)
)
# =====================================================
# PANEL FINAL
# =====================================================
final_map <- tmap_arrange(
map_main,
map_zoom,
ncol = 2,
widths = c(2.4, 1.2),
outer.margins = 0
)
final_map
final_map
