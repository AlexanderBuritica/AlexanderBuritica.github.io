library(sf)
library(dplyr)
library(tmap)
library(rnaturalearth)
library(rnaturalearthdata)
df$a19_1.x <- as.numeric(df$a19_1.x)  # latitude
df$a19_2.x <- as.numeric(df$a19_2.x)  # longitude
df_sf <- df %>%
st_as_sf(coords = c("a19_2.x", "a19_1.x"),  # lon, lat
crs = 4326, remove = FALSE)
df_sf$cluster_label <- factor(
df_sf$clust_m3_5_,
levels = c(1, 2, 3),
labels = c("Cluster 1", "Cluster 2", "Cluster 3")
)
colombia    <- ne_countries(scale = "medium", country = "Colombia", returnclass = "sf")
departments <- ne_states(country = "Colombia", returnclass = "sf")
tmap_mode("plot")
tmap_style("white")   # o simplemente quita el tmap_style()
map_main <-
tm_shape(colombia) +
tm_polygons(col = "grey95", border.col = "grey80", lwd = 0.6) +
tm_shape(departments) +
tm_borders(col = "white", lwd = 0.4) +
tm_shape(df_sf) +
tm_symbols(
col    = "cluster_label",
shape  = "cluster_label",
palette = c("#1b9e77", "#d95f02", "#7570b3"),   # colores por cluster
shapes  = c(21, 24, 22),                        # circle, triangle, square
size    = 0.10,
alpha   = 0.85,
border.col = "black",
border.lwd = 0.3,
legend.col.show = FALSE,                        # oculta leyenda de color
title.shape = "Exposure cluster"                # solo una leyenda
) +
tm_layout(
title             = "Coffee farms by exposure cluster",
frame             = FALSE,
legend.outside    = FALSE,
legend.position   = c("center", "bottom"),
legend.stack      = "horizontal",
legend.title.size = 0.9,
legend.text.size  = 0.7,
inner.margins     = c(0.02, 0.02, 0.10, 0.02),
bg.color          = "white"
)
map_main
library(sf)
library(dplyr)
library(tmap)
library(rnaturalearth)
library(rnaturalearthdata)
tmap_mode("plot")
# =========================================================
# 1. PALETA EN ESCALA DE GRISES
# =========================================================
cluster_cols   <- c("black", "grey40", "grey75")
# circle, triangle, square
cluster_shapes <- c(21, 24, 22)
cluster_labs   <- c("Cluster 1", "Cluster 2", "Cluster 3")
# =========================================================
# 2. MAPA PRINCIPAL
# =========================================================
map_main <-
tm_shape(colombia) +
tm_polygons(
col = "grey92",
border.col = "grey70",
lwd = 0.5
) +
tm_shape(departments) +
tm_borders(
col = "white",
lwd = 0.35
) +
tm_shape(df_sf) +
tm_symbols(
col     = "cluster_label",
shape   = "cluster_label",
palette = cluster_cols,
shapes  = cluster_shapes,
size    = 0.16,
alpha   = 1,
border.col = "black",
border.lwd = 0.35,
legend.col.show   = FALSE,
legend.shape.show = FALSE
) +
tm_add_legend(
type   = "symbol",
col    = cluster_cols,
shape  = cluster_shapes,
labels = cluster_labs,
title  = "Exposure cluster"
) +
tm_layout(
title = "Coffee farms by exposure cluster",
title.size = 1.1,
title.fontface = "bold",
frame = FALSE,
bg.color = "white",
legend.outside = FALSE,
legend.position = c("center", "bottom"),
legend.title.size = 0.9,
legend.text.size = 0.75,
inner.margins = c(0.03, 0.03, 0.12, 0.03)
)
# =========================================================
# 3. ZOOM
# =========================================================
bb_zoom <- st_bbox(
c(
xmin = -76.5,
xmax = -75.0,
ymin = 3.5,
ymax = 5.5
),
crs = st_crs(df_sf)
)
map_zoom <-
tm_shape(colombia, bbox = bb_zoom) +
tm_polygons(
col = "grey92",
border.col = "grey70",
lwd = 0.4
) +
tm_shape(departments, bbox = bb_zoom) +
tm_borders(
col = "white",
lwd = 0.3
) +
tm_shape(df_sf, bbox = bb_zoom) +
tm_symbols(
col     = "cluster_label",
shape   = "cluster_label",
palette = cluster_cols,
shapes  = cluster_shapes,
size    = 0.24,
alpha   = 1,
border.col = "black",
border.lwd = 0.35,
legend.show = FALSE
) +
tm_layout(
title = "Zoom: main coffee belt",
title.size = 0.95,
frame = TRUE,
frame.lwd = 0.8,
bg.color = "white",
inner.margins = c(0.03, 0.03, 0.03, 0.03)
)
