cat("Empleados en Tecnología :", n_tech, "de", n_obs, "\n")
cat("Proporción estimada (p̂) :", round(p_hat * 100, 1), "%\n")
cat("SE(p̂)                   :", round(SE_prop * 100, 2), "pp\n")
cat("Margen de error          :", round(margen_p * 100, 1), "pp\n")
cat("IC 95% = [", round(ic_p_inf * 100, 1), "%, ",
round(ic_p_sup * 100, 1), "%]\n", sep = "")
# Verificación con prop.test()
resultado_prop <- prop.test(n_tech, n_obs, conf.level = 0.95)
cat("\nResultado con prop.test():\n")
print(resultado_prop$conf.int * 100)  # en porcentaje
tamanos <- c(20, 50, 100, 200, 300, 500, 1000)
resultados_n <- data.frame(
n         = tamanos,
SE        = sd_muestral / sqrt(tamanos),
margen    = z_95 * (sd_muestral / sqrt(tamanos)),
ancho_ic  = 2 * z_95 * (sd_muestral / sqrt(tamanos))
)
cat("=== Efecto del tamaño de muestra ===\n")
print(round(resultados_n))
# Visualización del ancho del IC según n
ggplot(resultados_n, aes(x = n, y = ancho_ic / 1e6)) +
geom_line(color = "#2c3e8c", linewidth = 1.3) +
geom_point(color = "#2c3e8c", size = 3) +
geom_point(data = resultados_n[resultados_n$n == 300, ],
aes(x = n, y = ancho_ic / 1e6),
color = "tomato", size = 5) +
annotate("text", x = 320, y = resultados_n$ancho_ic[resultados_n$n == 300] / 1e6 + 0.05,
label = "Nuestra\nmuestra (n=300)", hjust = 0, size = 3.5, color = "tomato") +
labs(
title    = "A mayor tamaño de muestra, el IC se estrecha",
subtitle = "Ancho del IC al 95% según n (con S constante = $1.5M COP)",
x        = "Tamaño de muestra (n)",
y        = "Ancho del IC (millones COP)",
caption  = "Principio de consistencia: más datos → mayor precisión"
) +
theme_minimal(base_size = 13)
# Definimos el "verdadero" parámetro poblacional (conocido porque simulamos)
mu_verdadero <- 4200000
N_ics   <- 100
n_ic    <- 50    # muestras pequeñas para que se note la variación
sim_ics <- data.frame(
rep      = 1:N_ics,
media    = NA_real_,
lim_inf  = NA_real_,
lim_sup  = NA_real_
)
for (i in 1:N_ics) {
muestra_i     <- rnorm(n_ic, mean = mu_verdadero, sd = sd_muestral)
resultado_i   <- t.test(muestra_i, conf.level = 0.95)
sim_ics$media[i]   <- resultado_i$estimate
sim_ics$lim_inf[i] <- resultado_i$conf.int[1]
sim_ics$lim_sup[i] <- resultado_i$conf.int[2]
}
sim_ics$contiene_mu <- sim_ics$lim_inf <= mu_verdadero &
sim_ics$lim_sup >= mu_verdadero
sim_ics$color       <- ifelse(sim_ics$contiene_mu, "Contiene µ", "No contiene µ")
tasa_exito <- mean(sim_ics$contiene_mu) * 100
cat("\n=== Simulación de 100 ICs ===\n")
cat("ICs que contienen µ:", sum(sim_ics$contiene_mu), "de 100\n")
cat("Tasa de éxito      :", tasa_exito, "% (esperado ≈ 95%)\n")
ggplot(sim_ics, aes(x = rep, y = media / 1e6,
ymin = lim_inf / 1e6, ymax = lim_sup / 1e6,
color = color)) +
geom_hline(yintercept = mu_verdadero / 1e6,
color = "black", linewidth = 0.8, linetype = "dashed") +
geom_errorbar(linewidth = 0.7, width = 0.3) +
geom_point(size = 1.2) +
scale_color_manual(values = c("Contiene µ" = "#2c3e8c",
"No contiene µ" = "tomato")) +
coord_flip() +
labs(
title    = paste0("100 intervalos de confianza al 95% (n = ", n_ic, " c/u)"),
subtitle = paste0(sum(sim_ics$contiene_mu),
" de 100 ICs contienen el verdadero µ = $",
mu_verdadero / 1e6, "M"),
x        = "Muestra #",
y        = "Salario mensual promedio (millones COP)",
color    = NULL,
caption  = "Línea negra = verdadero µ poblacional"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "top")
calcular_ic <- function(x, nivel = 0.95) {
res <- t.test(x, conf.level = nivel)
data.frame(
media   = res$estimate,
lim_inf = res$conf.int[1],
lim_sup = res$conf.int[2],
n       = length(x)
)
}
# IC por sector
ics_sector <- do.call(rbind, lapply(
split(salarios$salario, salarios$sector),
calcular_ic
))
ics_sector$grupo <- rownames(ics_sector)
cat("\n=== ICs por sector (95%) ===\n")
print(round(ics_sector[, c("grupo", "n", "media", "lim_inf", "lim_sup")]))
str(salarios$sector)
salarios$sector<-as.factor(salarios$sector)
# Función auxiliar para calcular IC con t.test
calcular_ic <- function(x, nivel = 0.95) {
res <- t.test(x, conf.level = nivel)
data.frame(
media   = res$estimate,
lim_inf = res$conf.int[1],
lim_sup = res$conf.int[2],
n       = length(x)
)
}
# IC por sector
ics_sector <- do.call(rbind, lapply(
split(salarios$salario, salarios$sector),
calcular_ic
))
ics_sector$grupo <- rownames(ics_sector)
cat("\n=== ICs por sector (95%) ===\n")
print(round(ics_sector[, c("grupo", "n", "media", "lim_inf", "lim_sup")]))
str(salarios$sector)
colnames(salarios)
# Función auxiliar para calcular IC con t.test
calcular_ic <- function(x, nivel = 0.95) {
res <- t.test(x, conf.level = nivel)
data.frame(
media   = res$estimate,
lim_inf = res$conf.int[1],
lim_sup = res$conf.int[2],
n       = length(x)
)
}
# IC por sector
ics_sector <- do.call(rbind, lapply(
split(salarios$salario, as.factor(salarios$sector)),
calcular_ic
))
ics_sector$grupo <- rownames(ics_sector)
cat("\n=== ICs por sector (95%) ===\n")
print(round(ics_sector[, c("grupo", "n", "media", "lim_inf", "lim_sup")]))
# =============================================================================
# BA2 – Estadística para la Toma de Decisiones
# Clase 6 · Guía práctica en R
# Tema: Estimación puntual, intervalos de confianza y comunicación de resultados
# Caso: Salarios en empresas colombianas
# Instructor: Alexander Buriticá Casanova · Business Analytics 2026-1
# =============================================================================
#
# INSTRUCCIONES PARA EJECUTAR ESTE SCRIPT
# ----------------------------------------
# 1. Abre RStudio.
# 2. Abre este archivo: File > Open File...
# 3. Ejecuta cada sección con Ctrl+Enter (línea a línea)
#    o selecciona un bloque y presiona Ctrl+Enter.
# 4. Los resultados aparecen en la consola (abajo).
#    Los gráficos aparecen en el panel "Plots" (derecha).
#
# CONSEJO: Lee cada comentario (#) antes de ejecutar el código.
# =============================================================================
# =============================================================================
# PARTE 0 · Paquetes necesarios
# =============================================================================
# Sólo necesitamos {ggplot2} para visualizaciones elegantes.
# Si no lo tienes instalado, descomenta la línea de abajo (quita el #):
# install.packages("ggplot2")
library(ggplot2)
# Fijamos una semilla para que los números aleatorios sean reproducibles.
# Esto garantiza que todos en la clase obtengan exactamente los mismos datos.
set.seed(2026)
# =============================================================================
# PARTE 1 · Simulación del dataset
# =============================================================================
# Contexto:
#   Una consultora de RR.HH. recopiló información salarial de empleados de
#   nivel analista en Bogotá, Medellín y Cali durante el primer trimestre de
#   2026. Queremos estimar el salario mensual promedio de esta población y
#   construir intervalos de confianza para comunicar la incertidumbre.
#
# Nota metodológica:
#   Los parámetros de simulación (media ~$4.2M, SD ~$1.5M) son consistentes
#   con rangos reportados por portales como Computrabajo y LinkedIn Salary
#   para perfiles de analista en Colombia (2024-2025).
n_total <- 300  # tamaño del dataset completo
salarios <- data.frame(
id       = 1:n_total,
salario  = round(rnorm(n_total, mean = 4200000, sd = 1500000), -3),
ciudad   = sample(c("Bogotá", "Medellín", "Cali"),
size = n_total,
replace = TRUE,
prob = c(0.50, 0.30, 0.20)),
sector   = sample(c("Tecnología", "Finanzas", "Retail", "Manufactura"),
size = n_total,
replace = TRUE,
prob = c(0.30, 0.25, 0.25, 0.20)),
genero   = sample(c("Mujer", "Hombre"),
size = n_total, replace = TRUE, prob = c(0.48, 0.52))
)
# Eliminamos salarios negativos (artefacto de la simulación normal)
salarios <- salarios[salarios$salario > 0, ]
# Vista rápida del dataset
head(salarios, 10)
str(salarios)
nrow(salarios)  # ¿Cuántas filas tenemos?
# -----------------------------------------------------------------------------
# PREGUNTA PARA REFLEXIONAR:
#   ¿Qué representa cada fila? ¿Qué representa cada columna?
# -----------------------------------------------------------------------------
# =============================================================================
# PARTE 2 · Estadísticos descriptivos básicos
# =============================================================================
# Antes de construir intervalos, siempre explora los datos.
# Media, mediana, mínimo, máximo
summary(salarios$salario)
# Desviación estándar y coeficiente de variación
media_muestral <- mean(salarios$salario)
sd_muestral    <- sd(salarios$salario)
n_obs          <- nrow(salarios)
cv             <- (sd_muestral / media_muestral) * 100
cat("=== Estadísticos descriptivos ===\n")
cat("Media muestral (X̄)       :", format(media_muestral, big.mark = ","), "COP\n")
cat("Desviación estándar (S)  :", format(round(sd_muestral, 0), big.mark = ","), "COP\n")
cat("Tamaño de muestra (n)    :", n_obs, "\n")
cat("Coef. de variación (CV)  :", round(cv, 1), "%\n")
# Histograma básico
ggplot(salarios, aes(x = salario / 1e6)) +
geom_histogram(bins = 25, fill = "#2c3e8c", color = "white", alpha = 0.85) +
geom_vline(xintercept = media_muestral / 1e6,
color = "tomato", linewidth = 1.2, linetype = "dashed") +
labs(
title    = "Distribución de salarios mensuales – Analistas Colombia 2026",
subtitle = paste0("Línea roja = media muestral ($",
round(media_muestral / 1e6, 2), "M COP)"),
x        = "Salario mensual (millones COP)",
y        = "Frecuencia",
caption  = "Fuente: simulación con parámetros de mercado laboral colombiano"
) +
theme_minimal(base_size = 13)
# -----------------------------------------------------------------------------
# INTERPRETACIÓN:
#   La distribución es aproximadamente normal (campana).
#   Esto es importante para validar el uso del IC estándar.
#   Con n = 300, el Teorema del Límite Central garantiza normalidad
#   de X̄ independientemente de la forma de los datos.
# -----------------------------------------------------------------------------
# =============================================================================
# PARTE 3 · El error estándar: cuánto varía X̄ entre muestras
# =============================================================================
# Recordatorio de fórmula: SE = S / sqrt(n)
SE <- sd_muestral / sqrt(n_obs)
cat("=== Error estándar ===\n")
cat("SE(X̄) = S / √n\n")
cat("SE(X̄) =", format(round(sd_muestral, 0), big.mark = ","),
"/", round(sqrt(n_obs), 2), "\n")
cat("SE(X̄) =", format(round(SE, 0), big.mark = ","), "COP\n\n")
cat("Interpretación: si tomáramos otra muestra de", n_obs,
"empleados,\n  la nueva media probablemente diferiría en ±",
format(round(SE, 0), big.mark = ","), "COP de la actual.\n")
# Verifiquemos esto con simulación ----------------------------------------
# Tomamos 1,000 muestras del mismo tamaño y calculamos su media
N_sims   <- 1000
medias_sim <- replicate(N_sims, mean(sample(salarios$salario, size = n_obs,
replace = TRUE)))
cat("\n=== Verificación por simulación (bootstrap) ===\n")
cat("Desviación estándar de las 1,000 medias simuladas:",
format(round(sd(medias_sim), 0), big.mark = ","), "COP\n")
cat("Error estándar teórico (S/√n):",
format(round(SE, 0), big.mark = ","), "COP\n")
cat("→ ¡Son muy similares! Esto confirma la fórmula.\n")
# Visualizamos la distribución de las medias simuladas (distribución muestral)
ggplot(data.frame(media = medias_sim), aes(x = media / 1e6)) +
geom_histogram(bins = 40, fill = "#27ae60", color = "white", alpha = 0.8) +
geom_vline(xintercept = media_muestral / 1e6,
color = "tomato", linewidth = 1.3, linetype = "dashed") +
labs(
title    = "Distribución muestral de X̄ (1,000 simulaciones)",
subtitle = "Cada barra = una muestra diferente de 300 empleados",
x        = "Media muestral (millones COP)",
y        = "Frecuencia",
caption  = "Resultado del Teorema del Límite Central (TLC)"
) +
theme_minimal(base_size = 13)
# -----------------------------------------------------------------------------
# INTERPRETACIÓN:
#   Aunque los salarios individuales varían mucho ($1M a $9M),
#   las medias muestrales se agrupan en un rango mucho más estrecho.
#   Esto es el TLC en acción: la media es estable y predecible.
# -----------------------------------------------------------------------------
# =============================================================================
# PARTE 4 · Construcción manual del IC al 95%
# =============================================================================
# Fórmula: IC = X̄ ± z * SE    con z = 1.96 para 95% de confianza
z_95 <- qnorm(0.975)   # 1.959964
cat("Valor z para 95% de confianza:", round(z_95, 4), "\n")
margen_error <- z_95 * SE
lim_inferior <- media_muestral - margen_error
lim_superior <- media_muestral + margen_error
cat("\n=== Intervalo de Confianza al 95% (cálculo manual) ===\n")
cat("X̄ (estimación puntual)  :", format(round(media_muestral, 0), big.mark = ","), "COP\n")
cat("SE                      :", format(round(SE, 0), big.mark = ","), "COP\n")
cat("z (95%)                 :", round(z_95, 4), "\n")
cat("Margen de error (z*SE)  :", format(round(margen_error, 0), big.mark = ","), "COP\n")
cat("IC 95% = [", format(round(lim_inferior, 0), big.mark = ","),
",", format(round(lim_superior, 0), big.mark = ","), "] COP\n")
# Reporte ejecutivo
cat("\n--- REPORTE PARA PRESENTAR ---\n")
cat("Basados en una muestra de", n_obs, "empleados de nivel analista en Colombia,\n")
cat("el salario mensual promedio estimado es de $",
format(round(media_muestral / 1e6, 2), nsmall = 2), "M COP,\n", sep = "")
cat("con un intervalo de confianza al 95% de [$",
round(lim_inferior / 1e6, 2), "M, $",
round(lim_superior / 1e6, 2), "M] COP.\n", sep = "")
# =============================================================================
# PARTE 5 · Construcción automática con t.test()
# =============================================================================
# R tiene una función incorporada que hace todo esto en una línea.
# Usa la distribución t (más apropiada cuando estimamos σ con S),
# aunque con n = 300 la diferencia con z es mínima.
resultado_ttest <- t.test(salarios$salario, conf.level = 0.95)
print(resultado_ttest)
# Extraer componentes del resultado
cat("\n=== Extracción de componentes del t.test ===\n")
cat("Media estimada    :", format(round(resultado_ttest$estimate, 0), big.mark = ","), "COP\n")
cat("Límite inferior IC:", format(round(resultado_ttest$conf.int[1], 0), big.mark = ","), "COP\n")
cat("Límite superior IC:", format(round(resultado_ttest$conf.int[2], 0), big.mark = ","), "COP\n")
# Comparamos z vs t
t_95 <- qt(0.975, df = n_obs - 1)
cat("\n=== Comparación z vs t (n =", n_obs, ") ===\n")
cat("z (normal)    :", round(z_95, 4), "\n")
cat("t (Student)   :", round(t_95, 4), "\n")
cat("Diferencia    :", round(t_95 - z_95, 6), "→ prácticamente igual con n grande.\n")
# =============================================================================
# PARTE 6 · IC para proporciones
# =============================================================================
# Pregunta: ¿Qué proporción de analistas trabaja en el sector tecnológico?
n_tech    <- sum(salarios$sector == "Tecnología")
p_hat     <- n_tech / n_obs
SE_prop   <- sqrt(p_hat * (1 - p_hat) / n_obs)
margen_p  <- z_95 * SE_prop
ic_p_inf  <- p_hat - margen_p
ic_p_sup  <- p_hat + margen_p
cat("=== IC para proporción: sector Tecnología ===\n")
cat("Empleados en Tecnología :", n_tech, "de", n_obs, "\n")
cat("Proporción estimada (p̂) :", round(p_hat * 100, 1), "%\n")
cat("SE(p̂)                   :", round(SE_prop * 100, 2), "pp\n")
cat("Margen de error          :", round(margen_p * 100, 1), "pp\n")
cat("IC 95% = [", round(ic_p_inf * 100, 1), "%, ",
round(ic_p_sup * 100, 1), "%]\n", sep = "")
# Verificación con prop.test()
resultado_prop <- prop.test(n_tech, n_obs, conf.level = 0.95)
cat("\nResultado con prop.test():\n")
print(resultado_prop$conf.int * 100)  # en porcentaje
# =============================================================================
# PARTE 7 · Efecto del tamaño de muestra sobre el IC
# =============================================================================
# Pregunta clave: ¿Qué pasa con el IC si tenemos más o menos datos?
tamanos <- c(20, 50, 100, 200, 300, 500, 1000)
resultados_n <- data.frame(
n         = tamanos,
SE        = sd_muestral / sqrt(tamanos),
margen    = z_95 * (sd_muestral / sqrt(tamanos)),
ancho_ic  = 2 * z_95 * (sd_muestral / sqrt(tamanos))
)
cat("=== Efecto del tamaño de muestra ===\n")
print(round(resultados_n))
# Visualización del ancho del IC según n
ggplot(resultados_n, aes(x = n, y = ancho_ic / 1e6)) +
geom_line(color = "#2c3e8c", linewidth = 1.3) +
geom_point(color = "#2c3e8c", size = 3) +
geom_point(data = resultados_n[resultados_n$n == 300, ],
aes(x = n, y = ancho_ic / 1e6),
color = "tomato", size = 5) +
annotate("text", x = 320, y = resultados_n$ancho_ic[resultados_n$n == 300] / 1e6 + 0.05,
label = "Nuestra\nmuestra (n=300)", hjust = 0, size = 3.5, color = "tomato") +
labs(
title    = "A mayor tamaño de muestra, el IC se estrecha",
subtitle = "Ancho del IC al 95% según n (con S constante = $1.5M COP)",
x        = "Tamaño de muestra (n)",
y        = "Ancho del IC (millones COP)",
caption  = "Principio de consistencia: más datos → mayor precisión"
) +
theme_minimal(base_size = 13)
# =============================================================================
# PARTE 8 · Visualización clásica: muchos ICs, algunos fallan
# =============================================================================
# Esta simulación reproduce el gráfico conceptual de los slides:
# si construimos 100 ICs, ~95 deben contener el verdadero parámetro.
# Definimos el "verdadero" parámetro poblacional (conocido porque simulamos)
mu_verdadero <- 4200000
N_ics   <- 100
n_ic    <- 50    # muestras pequeñas para que se note la variación
sim_ics <- data.frame(
rep      = 1:N_ics,
media    = NA_real_,
lim_inf  = NA_real_,
lim_sup  = NA_real_
)
for (i in 1:N_ics) {
muestra_i     <- rnorm(n_ic, mean = mu_verdadero, sd = sd_muestral)
resultado_i   <- t.test(muestra_i, conf.level = 0.95)
sim_ics$media[i]   <- resultado_i$estimate
sim_ics$lim_inf[i] <- resultado_i$conf.int[1]
sim_ics$lim_sup[i] <- resultado_i$conf.int[2]
}
sim_ics$contiene_mu <- sim_ics$lim_inf <= mu_verdadero &
sim_ics$lim_sup >= mu_verdadero
sim_ics$color       <- ifelse(sim_ics$contiene_mu, "Contiene µ", "No contiene µ")
tasa_exito <- mean(sim_ics$contiene_mu) * 100
cat("\n=== Simulación de 100 ICs ===\n")
cat("ICs que contienen µ:", sum(sim_ics$contiene_mu), "de 100\n")
cat("Tasa de éxito      :", tasa_exito, "% (esperado ≈ 95%)\n")
ggplot(sim_ics, aes(x = rep, y = media / 1e6,
ymin = lim_inf / 1e6, ymax = lim_sup / 1e6,
color = color)) +
geom_hline(yintercept = mu_verdadero / 1e6,
color = "black", linewidth = 0.8, linetype = "dashed") +
geom_errorbar(linewidth = 0.7, width = 0.3) +
geom_point(size = 1.2) +
scale_color_manual(values = c("Contiene µ" = "#2c3e8c",
"No contiene µ" = "tomato")) +
coord_flip() +
labs(
title    = paste0("100 intervalos de confianza al 95% (n = ", n_ic, " c/u)"),
subtitle = paste0(sum(sim_ics$contiene_mu),
" de 100 ICs contienen el verdadero µ = $",
mu_verdadero / 1e6, "M"),
x        = "Muestra #",
y        = "Salario mensual promedio (millones COP)",
color    = NULL,
caption  = "Línea negra = verdadero µ poblacional"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "top")
# =============================================================================
# PARTE 9 · ICs por subgrupo: brechas salariales
# =============================================================================
# Aplicación directa: ¿existen diferencias salariales entre sectores o ciudades?
# Función auxiliar para calcular IC con t.test
calcular_ic <- function(x, nivel = 0.95) {
res <- t.test(x, conf.level = nivel)
data.frame(
media   = res$estimate,
lim_inf = res$conf.int[1],
lim_sup = res$conf.int[2],
n       = length(x)
)
}
# IC por sector
ics_sector <- do.call(rbind, lapply(
split(salarios$salario, salarios$sector),
calcular_ic
))
ics_sector$grupo <- rownames(ics_sector)
cat("\n=== ICs por sector (95%) ===\n")
ics_sector_print <- ics_sector[, c("grupo", "n", "media", "lim_inf", "lim_sup")]
ics_sector_print[, c("media", "lim_inf", "lim_sup")] <-
round(ics_sector_print[, c("media", "lim_inf", "lim_sup")])
print(ics_sector_print)
# Visualización: forest plot por sector
ggplot(ics_sector, aes(x = reorder(grupo, media),
y = media / 1e6,
ymin = lim_inf / 1e6,
ymax = lim_sup / 1e6)) +
geom_pointrange(color = "#2c3e8c", linewidth = 1, size = 0.8) +
geom_hline(yintercept = media_muestral / 1e6,
linetype = "dashed", color = "gray50") +
coord_flip() +
labs(
title    = "Salario promedio por sector con IC al 95%",
subtitle = "Línea gris = media global de la muestra",
x        = NULL,
y        = "Salario mensual promedio (millones COP)",
caption  = paste0("n total = ", n_obs,
" | Sectores con ICs que no se traslapan sugieren diferencias reales")
) +
theme_minimal(base_size = 13)
View(ics_sector_print)
# IC por género (brecha salarial)
ics_genero <- do.call(rbind, lapply(
split(salarios$salario, salarios$genero),
calcular_ic
))
ics_genero$grupo <- rownames(ics_genero)
cat("\n=== ICs por género (95%) ===\n")
ics_genero_print <- ics_genero[, c("grupo", "n", "media", "lim_inf", "lim_sup")]
ics_genero_print[, c("media", "lim_inf", "lim_sup")] <-
round(ics_genero_print[, c("media", "lim_inf", "lim_sup")])
print(ics_genero_print)
# ¿Se traslapan los ICs de Hombre y Mujer?
cat("\n--- Interpretación brecha salarial ---\n")
if (ics_genero["Hombre", "lim_inf"] > ics_genero["Mujer", "lim_sup"] |
ics_genero["Mujer", "lim_inf"]  > ics_genero["Hombre", "lim_sup"]) {
cat("Los ICs NO se traslapan → evidencia estadística de brecha salarial.\n")
} else {
cat("Los ICs SE TRASLAPAN → no hay evidencia suficiente para afirmar brecha significativa.\n")
cat("(Recuerda: ausencia de evidencia ≠ evidencia de ausencia.)\n")
}
ggplot(ics_genero, aes(x = reorder(grupo, media),
y = media / 1e6,
ymin = lim_inf / 1e6,
ymax = lim_sup / 1e6)) +
geom_pointrange(color = "#2c3e8c", linewidth = 1, size = 0.8) +
geom_hline(yintercept = media_muestral / 1e6,
linetype = "dashed", color = "gray50") +
coord_flip() +
labs(
title    = "Salario promedio por sector con IC al 95%",
subtitle = "Línea gris = media global de la muestra",
x        = NULL,
y        = "Salario mensual promedio (millones COP)",
caption  = paste0("n total = ", n_obs,
" | Sectores con ICs que no se traslapan sugieren diferencias reales")
) +
theme_minimal(base_size = 13)
