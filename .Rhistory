bcol<- read.dta("Impact.dta")
row.names(bcol)<-bcol$a_idconcat
bcol<-subset(x=bcol,!is.na(bcol$a_proyect_12_1))
bcol422<-subset(x=bcol,!is.na(bcol$a_conben))
AltitudLabels2 <- c("Sin Tratamiento", "Beneficiarios")
bcol$a_proyect_12_1 <- factor(bcol$a_proyect_12_1,labels=AltitudLabels2)
AltitudLabels1 <- c("No comercializo", "Comercializar?n")
bcol$trat_paper <- factor(bcol$trat_paper,labels=AltitudLabels1)
AltitudLabels3 <- c("No Certificaci?n", "Certificaci?n")
bcol$j_cert_12 <- factor(bcol$j_cert_12,labels=AltitudLabels3)
graphdata<-subset(x=bcol,!is.na(bcol$trat_paper))
graphdata_ben<-subset(x=bcol,a_proyect_12_1=="Beneficiarios")
AltitudLabels4 <- c("No Cataron", "Cataron")
AltitudLabels5 <- c("Low Areas", "High Areas")
grupos <- c("Sin Tratamiento", "Asesor?as","Asesor?as+Prueba de Cata")
graphdata$dummy_alt <- factor(graphdata$dummy_alt,labels=AltitudLabels5)
graphdata_ben$catacion <- factor(graphdata_ben$catacion,labels=AltitudLabels4)
graphdata_ben<-subset(x=graphdata_ben,graphdata_ben$FinalScore>73)
bcol<-bcol%>%mutate(difprecios=l_cofpri_16-l_cofpri_12)
bcol$type_trata <- factor(bcol$type_trata,labels=grupos)
precio<-subset(x=bcol,!is.na(bcol$difprecios))
