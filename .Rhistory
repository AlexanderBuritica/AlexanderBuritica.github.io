# ===== 3) Explosión y mapeo (con auditoría) =====
actors_long0 <- CostMarfil_po %>%
select(policy_id, category_norm, gov_structure) %>%
filter(!is.na(gov_structure), str_squish(gov_structure) != "") %>%
mutate(raw_actors = map(gov_structure, split_actors)) %>%
unnest_longer(raw_actors, values_to = "actor_raw") %>%
mutate(
actor_raw  = str_squish(actor_raw),
actor_norm = norm_txt_simple(actor_raw)
) %>%
filter(actor_norm != "") %>%
mutate(
# buscamos el PRIMER patrón que calce; el orden en actor_map_tbl importa
dict_match = map_chr(
actor_norm,
~{
hits <- actor_map_tbl$actor_short[str_detect(.x, actor_map_tbl$pattern)]
if (length(hits) >= 1) hits[1] else NA_character_
}
),
actor_clean = strip_garbage(actor_norm),
# fallback a acrónimo solo si no hubo match y no es un encabezado genérico
is_generic = str_detect(actor_norm, "(?i)government representatives|civil society|private sector|technical and financial partners|research structures|national technical structures"),
fallback   = if_else(is.na(dict_match) & !is_generic, to_acronym(actor_clean), NA_character_),
actor      = coalesce(dict_match, fallback)
) %>%
filter(!is.na(actor), nchar(actor) >= 3)
# ===== 3.1) Auditoría rápida de no mapeados (para mejorar el diccionario) =====
unmatched_sample <- CostMarfil_po %>%
select(policy_id, gov_structure) %>%
filter(!is.na(gov_structure), str_squish(gov_structure) != "") %>%
mutate(raw_actors = map(gov_structure, split_actors)) %>%
unnest_longer(raw_actors, values_to = "actor_raw") %>%
mutate(actor_norm = norm_txt_simple(actor_raw)) %>%
filter(actor_norm != "") %>%
mutate(
matched = map_lgl(actor_norm, ~ any(str_detect(.x, actor_map_tbl$pattern)))
) %>%
filter(!matched) %>%
count(actor_norm, sort = TRUE)
# (opcional) ver top 30 no mapeados:
print(head(unmatched_sample, 30))
# ===== 3.a Diagnóstico — ¿qué sale en COCOA?
diag_cocoa <- actors_long0 %>%
filter(category_norm == "COCOA") %>%
count(actor, actor_raw, sort = TRUE)
print(diag_cocoa)  # ← aquí deberías ver MIN_AGRI, MINEF, MIN_ENV, CCC, etc.
# ===== 4) Conteo por categoría (actor puede estar en varias categorías) =====
actors_long <- actors_long0 %>%
distinct(category_norm, actor, policy_id) %>%      # un actor por política y categoría
group_by(category_norm, actor) %>%
summarise(n = n_distinct(policy_id), .groups = "drop")
# ===== 5) Sunburst (porcentajes visibles) =====
sector_totals <- actors_long %>%
group_by(category_norm) %>%
summarise(value = sum(n), .groups = "drop") %>%
mutate(pct_total = value / sum(value))
sun_df <- bind_rows(
tibble(
id      = sector_totals$category_norm,
label   = paste0(sector_totals$category_norm, " ", scales::percent(sector_totals$pct_total, accuracy = 1)),
parent  = NA_character_,
value   = sector_totals$value
),
actors_long %>%
group_by(category_norm) %>%
mutate(pct_parent = n / sum(n)) %>%
ungroup() %>%
transmute(
id     = paste0(category_norm, " / ", actor),
label  = paste0(actor, " ", scales::percent(pct_parent, accuracy = 1)),
parent = category_norm,
value  = n
)
)
p <- plot_ly(
labels  = sun_df$label,
parents = sun_df$parent,
values  = sun_df$value,
type    = "sunburst",
branchvalues = "total",
textinfo = "label",  # ya llevamos % en la etiqueta
hovertemplate = paste(
"<b>%{label}</b>",
"<br>Conteo: %{value}",
"<br>% del padre: %{percentParent:.1%}",
"<br>% del total: %{percentRoot:.1%}<extra></extra>"
)
)
p
# Requisitos
# install.packages(c("plotly","dplyr","tibble","scales"))
library(plotly)
library(dplyr)
library(tibble)
library(scales)
# ===== 4) Conteo por categoría (actor puede estar en varias categorías) =====
actors_long <- actors_long0 %>%
distinct(category_norm, actor, policy_id) %>%      # un actor por política y categoría
group_by(category_norm, actor) %>%
summarise(n = n_distinct(policy_id), .groups = "drop")
# Chequeo: no debe estar vacío
stopifnot(nrow(actors_long) > 0)
# ===== 5) Sunburst con raíz y ids únicos =====
# Totales por categoría (primer anillo)
sector_totals <- actors_long %>%
group_by(category_norm) %>%
summarise(value = sum(n), .groups = "drop")
# NODO RAÍZ
root_label <- "ALL_POLICIES"
root_df <- tibble(
id     = root_label,
label  = "All policies",
parent = "",
value  = sum(sector_totals$value)
)
# Nodos de CATEGORÍA (hijos del root)
cat_df <- sector_totals %>%
transmute(
id     = category_norm,
label  = category_norm,
parent = root_label,
value  = value
)
# Nodos de ACTOR (hijos de su categoría)
act_df <- actors_long %>%
group_by(category_norm) %>%
mutate(pct_parent = n / sum(n)) %>%
ungroup() %>%
transmute(
id     = paste0(category_norm, "::", actor),  # id único
label  = actor,                               # etiqueta limpia
parent = category_norm,
value  = n
)
sun_df <- bind_rows(root_df, cat_df, act_df)
# Sanidad: convertir a character y asegurar que no hay NAs en parents/labels/ids
sun_df <- sun_df %>%
mutate(
id     = as.character(id),
label  = as.character(label),
parent = as.character(parent),
value  = as.numeric(value)
)
# Opcional: ordenar
sun_df <- sun_df %>% arrange(parent, desc(value), label)
# Graficar
p <- plot_ly(
ids     = sun_df$id,
labels  = sun_df.label <- sun_df$label,  # asignación para usar en hover
parents = sun_df$parent,
values  = sun_df$value,
type    = "sunburst",
branchvalues = "total",
maxdepth = 3,
textinfo = "label+percent parent",
hovertemplate = paste(
"<b>%{label}</b>",
"<br>Conteo: %{value}",
"<br>% del padre: %{percentParent:.1%}",
"<br>% del total: %{percentRoot:.1%}<extra></extra>"
)
)
p
# ===== Sunburst SIN % en el anillo interno; % solo en actores =====
library(plotly)
library(dplyr)
library(tibble)
library(scales)
# Totales por categoría (primer anillo)
sector_totals <- actors_long %>%
group_by(category_norm) %>%
summarise(value = sum(n), .groups = "drop")
# Nodo raíz
root_label <- "ALL_POLICIES"
root_df <- tibble(
id     = root_label,
label  = "All policies",
parent = "",
value  = sum(sector_totals$value)
)
# Nodos de CATEGORÍA (SIN % en la etiqueta)
cat_df <- sector_totals %>%
transmute(
id     = category_norm,
label  = category_norm,     # <- solo el nombre, sin porcentajes
parent = root_label,
value  = value
)
# Nodos de ACTOR (CON % del padre en la etiqueta)
act_df <- actors_long %>%
group_by(category_norm) %>%
mutate(pct_parent = n / sum(n)) %>%
ungroup() %>%
transmute(
id     = paste0(category_norm, "::", actor),             # id único
label  = paste0(actor, " ", percent(pct_parent, 1)),    # <- nombre + %
parent = category_norm,
value  = n
)
sun_df <- bind_rows(root_df, cat_df, act_df) %>%
mutate(
id     = as.character(id),
label  = as.character(label),
parent = as.character(parent),
value  = as.numeric(value)
) %>%
arrange(parent, desc(value), label)
p <- plot_ly(
ids     = sun_df$id,
labels  = sun_df$label,    # usamos SOLO la etiqueta calculada
parents = sun_df$parent,
values  = sun_df$value,
type    = "sunburst",
branchvalues = "total",
maxdepth = 3,
textinfo = "label",        # <- NO agrega % automático; usamos nuestras etiquetas
hovertemplate = paste(
"<b>%{label}</b>",
"<br>Conteo: %{value}",
"<br>% del padre: %{percentParent:.1%}",
"<br>% del total: %{percentRoot:.1%}<extra></extra>"
)
)
p
# ----------------# # # -------------------------------# # # # # -----------
# # # ----------------# # # -------------------------------# # # # # -----------
# # # ----------------# # # -------------------------------# # # # # -----------
# 1) Conteos por actor (actor puede estar en varias categorías; n = # de políticas únicas donde aparece)
library(scales)
# 2) Conteo de políticas por categoría (anillo interno)
policy_counts <- CostMarfil_po %>%
dplyr::group_by(category_norm) %>%
dplyr::summarise(policy_n = dplyr::n_distinct(policy_id), .groups = "drop")
# === NUEVO: agrega % del total en la etiqueta del anillo interno ===
total_policies <- sum(policy_counts$policy_n)
policy_counts  <- policy_counts %>%
dplyr::mutate(pct_total = policy_n / total_policies)
# 3) (sin cambios) escalar actores para que sumen al # de políticas por categoría
act_scaled <- actors_long %>%
dplyr::group_by(category_norm) %>%
dplyr::mutate(total_links = sum(n)) %>%
dplyr::ungroup() %>%
dplyr::left_join(policy_counts, by = "category_norm") %>%
dplyr::mutate(
scale = dplyr::if_else(total_links > 0, policy_n / total_links, 0),
value = n * scale
)
# 4) Sunburst (con raíz + categorías con % en etiqueta + actores)
root_label <- "ALL_POLICIES"
root_df <- tibble::tibble(
id     = root_label,
label  = "All policies",
parent = "",
value  = total_policies
)
# === AQUÍ VA EL CAMBIO PRINCIPAL: etiqueta con % en anillo interno ===
cat_df <- policy_counts %>%
dplyr::transmute(
id     = category_norm,
label  = paste0(category_norm, " ", scales::percent(pct_total, accuracy = 1)),
parent = root_label,
value  = policy_n
)
act_df <- act_scaled %>%
dplyr::group_by(category_norm) %>%
dplyr::mutate(pct_parent = n / sum(n)) %>%
dplyr::ungroup() %>%
dplyr::transmute(
id     = paste0(category_norm, "::", actor),
label  = paste0(actor, " ", scales::percent(pct_parent, accuracy = 1)),
parent = category_norm,
value  = value
)
sun_df <- dplyr::bind_rows(root_df, cat_df, act_df) %>%
dplyr::mutate(
id     = as.character(id),
label  = as.character(label),
parent = as.character(parent),
value  = as.numeric(value)
) %>%
dplyr::arrange(parent, dplyr::desc(value), label)
p <- plotly::plot_ly(
ids     = sun_df$id,
labels  = sun_df$label,     # categorías ya llevan % del total en la etiqueta
parents = sun_df$parent,
values  = sun_df$value,
type    = "sunburst",
branchvalues = "total",
maxdepth = 3,
textinfo = "label",         # % solo en etiquetas que tú definiste
hovertemplate = paste(
"<b>%{label}</b>",
"<br>Conteo: %{value}",
"<br>% del padre: %{percentParent:.1%}",
"<br>% del total: %{percentRoot:.1%}<extra></extra>"
)
)
p
#MIN_AGRI: Ministry of Agriculture and Rural Development
#MINEF: Ministry of Water and Forests
#MIN_ENV: Ministry of Environment and Sustainable Development
#MIN_PLAN: Ministry of Planning and Development
#MIN_FIN: Ministry of Economy and Finance
#MIN_SOC: Ministry of Employment / Social Affairs / Labour
#MIN_IND_COM: Ministry of Industry and Commerce/Trade
#MIN_TRANSP: Ministry of Transport
#MIN_ENERGY: Ministry of Petroleum and Energy / Energy Ministry
#MIN_EDU: Ministry of Education
#MIN_HEALTH: Ministry of Health
#MIN_STATE: Ministry of State (when listed explicitly)
#CCC: Coffee–Cocoa Council (Conseil du Café-Cacao)
#ANADER: Agence Nationale d’Appui au Développement Rural
#SODEFOR: Société de Développement des Forêts
#OIPR: Office Ivoirien des Parcs et Réserves
#CNRA: Centre National de Recherche Agronomique
#ICRAF: World Agroforestry (ICRAF)
#CSRS: Centre Suisse de Recherches Scientifiques en Côte d’Ivoire
#AFD: Agence Française de Développement
#EU_EFI: European Union / European Forest Institute
#WB: World Bank
#IDH: IDH – The Sustainable Trade Initiative
#UN_REDD: UN-REDD Programme
#AFDB: African Development Bank (BAD)
#GEF: Global Environment Facility
#APROMAC: Association des Professionnels du Caoutchouc Naturel de Côte d’Ivoire (o gremio afín)
#AIPH: Association Ivoirienne des Professionnels de l’Hévéa (o afín)
#ONDR: Office National de Développement de la Riziculture (u organismo homólogo)
#FIRCA: Fonds Interprofessionnel pour la Recherche et le Conseil Agricoles
#BNEDT_CCT: Bureau National d’Études Techniques et de Développement / Cellule Café-Cacao et Techniques relacionadas
#WCF: World Cocoa Foundation
#OIREN: Organización/Red ambiental
p <- plotly::plot_ly(
ids     = sun_df$id,
labels  = sun_df$label,
parents = sun_df$parent,
values  = sun_df$value,
type    = "sunburst",
branchvalues = "total",
maxdepth = 3,
textinfo = "label",
hovertemplate = paste(
"<b>%{label}</b>",
"<br>Conteo: %{value}",
"<br>% del padre: %{percentParent:.1%}",
"<br>% del total: %{percentRoot:.1%}<extra></extra>"
),
textfont = list(size = 16)   # 🔹 tamaño de texto más grande
)
p
