p_real <- 0.08
n_ab <- 500
# 10,000 repeticiones del experimento
proporciones <- replicate(n_simulaciones, {
clicks <- rbinom(1, size = n_ab, prob = p_real)
clicks / n_ab  # proporcion muestral
})
# Verificar normalidad
se_teorico <- sqrt(p_real * (1 - p_real) / n_ab)
cat("SE empirico:", round(sd(proporciones), 4),
"| SE teorico:", round(se_teorico, 4), "\n")
hist(proporciones, breaks = 40, col = "steelblue",
border = "white", probability = TRUE,
main = "Distribucion muestral de p-hat (n = 500, p = 0.08)",
xlab = "Proporcion muestral")
# ============================================================
# CLASE 4 (VERSIÓN MUY DIDÁCTICA)
# Tema: ¿Por qué la media de una muestra se comporta "bien"?
# ============================================================
# ------------------------------------------------------------
# PASO 0: PREPARAR EL ENTORNO
# ------------------------------------------------------------
# 1) "Semilla": para que a todos nos salga lo mismo al correrlo.
set.seed(2026)
# 2) (Opcional) Paquete para gráficos más bonitos.
# Si no lo tienes instalado: install.packages("ggplot2")
library(ggplot2)
cat("✅ Clase 4: TLC y Error Estándar\n")
cat("Hoy veremos dos ideas:\n")
cat("  (1) La MEDIA cambia si repites la muestra.\n")
cat("  (2) Esa variación tiene un nombre: ERROR ESTÁNDAR.\n\n")
N_pop <- 100000   # tamaño de la población simulada (muy grande)
cat("PASO 1) Vamos a crear una población grande (N =", N_pop, ").\n\n")
cat("PASO 2) Población 1: tiempos de entrega (exponencial).\n")
cat("       Muchos tiempos cortos, pocos tiempos muy largos.\n\n")
# Creamos la población:
pob <- rexp(n = N_pop, rate = 1/30)  # promedio ~30 min
hist(pob)
# La "media real" de esta población (la conocemos porque simulamos):
mu_pop <- mean(pob)
# La "desviación estándar" de la población (cuánto se dispersan los datos):
sd_pop <- sd(pob)
cat("Media poblacional (aprox):", round(mu_pop, 2), "min\n")
cat("Desviación estándar poblacional (aprox):", round(sd_pop, 2), "min\n\n")
# Miramos la forma de la población:
hist(pob, breaks = 80, col = "gray80", border = "white",
main = "Población: tiempos de entrega (asimétrica)",
xlab = "Minutos")
n <- 50
cat("\nPASO 3) Tomemos UNA muestra de tamaño n =", n, ".\n")
muestra <- sample(pob, size = n, replace = TRUE)
hist(muestra)
media_muestra <- mean(muestra)
sd_muestra    <- sd(muestra)
cat("Media de esta muestra:", round(media_muestra, 2), "\n")
cat("SD de esta muestra:", round(sd_muestra, 2), "\n\n")
cat("⚠️ Importante: si tomas OTRA muestra distinta, la media cambia.\n")
B <- 10000  # número de repeticiones
cat("\nPASO 4) Repetiremos", B, "veces:\n")
cat("       (tomar muestra -> calcular media)\n\n")
medias <- replicate(B, {
m <- sample(pob, size = n, replace = TRUE)
mean(m)
})
# Ahora tenemos B medias, una por cada muestra.
cat("Listo. Tenemos", length(medias), "medias muestrales.\n\n")
cat("PASO 5) Grafiquemos las medias muestrales.\n")
cat("       ¿Se parecen a una campana?\n\n")
hist(medias, breaks = 50, col = "gray80", border = "white",
probability = TRUE,
main = paste0("Distribución de medias muestrales (n = ", n, ")"),
xlab = "Media muestral (X̄)")
abline(v = mu_pop, lty = 2, lwd = 2)
legend("topright", legend = "Media poblacional",
lty = 2, lwd = 2, bty = "n")
cat("\nPASO 6) Error Estándar (SE):\n")
cat("       Es la 'desviación estándar' de la media muestral.\n")
cat("       Regla importante:\n")
cat("       SE(X̄) = sigma / sqrt(n)\n\n")
se_teorico <- sd_pop / sqrt(n)
cat("Con esta población y n =", n, ":\n")
cat("SE teórico ≈", round(se_teorico, 2), "\n\n")
cat("Interpretación simple:\n")
cat("- Si repites muestras de tamaño n, la media suele moverse alrededor de mu.\n")
cat("- El SE nos dice el tamaño típico de ese movimiento.\n\n")
cat("PASO 7) Veamos qué pasa si aumentamos n.\n")
cat("       Compararemos n = 5, 30, 100, 500.\n\n")
ns <- c(5, 30, 100, 500)
resultados <- do.call(rbind, lapply(ns, function(n_i) {
medias_i <- replicate(B, mean(sample(pob, n_i, replace = TRUE)))
data.frame(n = paste0("n = ", n_i), media = medias_i)
}))
resultados$n <- factor(resultados$n, levels = paste0("n = ", ns))
ggplot(resultados, aes(x = media)) +
geom_histogram(aes(y = after_stat(density)),
bins = 50, fill = "gray80", color = "white") +
facet_wrap(~n, scales = "free") +
geom_vline(xintercept = mu_pop, linetype = "dashed") +
labs(title = "Cuando n aumenta: la media se vuelve más estable y más 'normal'",
x = "Media muestral (X̄)", y = "Densidad") +
theme_minimal(base_size = 12)
cat("\nMensaje clave:\n")
cat("✅ A mayor n, menos dispersión de X̄.\n")
cat("✅ A mayor n, X̄ se ve más como campana (Normal).\n\n")
cat("PASO 8) Veremos que el TLC funciona incluso si la población es rara.\n")
cat("       Usaremos tres poblaciones distintas.\n\n")
# 8.1 Uniforme: todo igual de probable
# Ejemplo: número aleatorio entre 0 y 100, sin sesgo.
pob_unif <- runif(N_pop, 0, 100)
# Ejemplo: número aleatorio entre 0 y 100, sin sesgo.
pob_unif <- runif(N_pop, 0, 100)
histo(pob_unif)
hist(pob_unif)
pob_bern <- rbinom(N_pop, size = 1, prob = 0.3)
par(mfrow = c(1, 3))
hist(pob_unif, breaks = 40, col = "gray80", border = "white",
main = "Uniforme (0 a 100)", xlab = "")
hist(pob_bimodal, breaks = 60, col = "gray80", border = "white",
main = "Bimodal (dos grupos)", xlab = "")
pob_bimodal <- c(rnorm(N_pop/2, 20, 3), rnorm(N_pop/2, 60, 5))
# 8.3 Bernoulli: 0/1 (sí/no)
# Ejemplo: click (1) o no click (0), compra (1) o no compra (0).
pob_bern <- rbinom(N_pop, size = 1, prob = 0.3)
par(mfrow = c(1, 3))
hist(pob_unif, breaks = 40, col = "gray80", border = "white",
main = "Uniforme (0 a 100)", xlab = "")
hist(pob_bimodal, breaks = 60, col = "gray80", border = "white",
main = "Bimodal (dos grupos)", xlab = "")
hist(pob_bern, breaks = 2, col = "gray80", border = "white",
main = "Bernoulli (0/1)", xlab = "")
par(mfrow = c(1, 1))
cat("Ahora simulamos medias con n = 50 para cada población.\n\n")
n_tlc <- 50
par(mfrow = c(1, 3))
for (item in list(
list(p = pob_unif,    nombre = "Uniforme"),
list(p = pob_bimodal, nombre = "Bimodal"),
list(p = pob_bern,    nombre = "Bernoulli")
)) {
mu <- mean(item$p)
se <- sd(item$p) / sqrt(n_tlc)
medias_i <- replicate(5000, mean(sample(item$p, n_tlc, replace = TRUE)))
hist(medias_i, breaks = 40, col = "gray80", border = "white",
probability = TRUE,
main = paste0("Medias (", item$nombre, ")"),
xlab = "X̄")
abline(v = mu, lty = 2, lwd = 2)
}
par(mfrow = c(1, 1))
cat("\nMensaje clave:\n")
cat("✅ No importa tanto la forma de la población.\n")
cat("✅ La media de muchas muestras tiende a comportarse como Normal.\n\n")
cat("PASO 9) Un caso donde NO funciona bien: Cauchy.\n")
cat("       Tiene 'outliers' extremos y varianza infinita.\n\n")
pob_cauchy <- rcauchy(N_pop)
hist(pob_cauchy)
hist(pob_cauchy[abs(pob_cauchy) < 20],
breaks = 60,
col = "gray80",
border = "white",
main = "Distribución Cauchy (recortada)",
xlab = "Valores")
hist(pob_cauchy,
breaks = 60,
col = "gray80",
border = "white",
main = "Distribución Cauchy (recortada)",
xlab = "Valores")
hist(pob_cauchy[abs(pob_cauchy) < 20],
breaks = 60,
col = "gray80",
border = "white",
main = "Distribución Cauchy (recortada)",
xlab = "Valores")
medias_c50  <- replicate(5000, mean(sample(pob_cauchy, 50,  replace = TRUE)))
medias_c500 <- replicate(5000, mean(sample(pob_cauchy, 500, replace = TRUE)))
par(mfrow = c(1, 2))
hist(medias_c50[abs(medias_c50) < 20], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=50)\n(recortado |X̄|<20)", xlab = "X̄")
hist(medias_c500[abs(medias_c500) < 20], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=500)\n(recortado |X̄|<20)", xlab = "X̄")
par(mfrow = c(1, 1))
cat("Conclusión: el TLC necesita 'varianza finita'.\n")
cat("Cauchy viola esa condición, por eso no se normaliza.\n\n")
par(mfrow = c(1, 2))
hist(medias_c50[abs(medias_c50) ], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=50)\n(recortado |X̄|<20)", xlab = "X̄")
hist(medias_c500[abs(medias_c500) ], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=500)\n(recortado |X̄|<20)", xlab = "X̄")
par(mfrow = c(1, 1))
par(mfrow = c(1, 2))
hist(medias_c50[abs(medias_c50) ], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=50)\n()", xlab = "X̄")
hist(medias_c500[abs(medias_c500) ], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=500)\n()", xlab = "X̄")
par(mfrow = c(1, 1))
par(mfrow = c(1, 2))
hist(medias_c50[abs(medias_c50) < 20], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=50)\n(recortado |X̄|<20)", xlab = "X̄")
hist(medias_c500[abs(medias_c500) < 20], breaks = 60,
col = "gray80", border = "white",
main = "Cauchy: medias (n=500)\n(recortado |X̄|<20)", xlab = "X̄")
par(mfrow = c(1, 1))
cat("Conclusión: el TLC necesita 'varianza finita'.\n")
cat("Cauchy viola esa condición, por eso no se normaliza.\n\n")
cat("PASO 10) Proporciones: ejemplo de A/B testing.\n")
cat("        Ejemplo: tasa de clicks real = 0.08 y muestra n = 500.\n\n")
# (1) Probabilidad real de click (la 'verdad' del ejemplo)
p_real <- 0.08
# (2) Tamaño de la muestra (número de personas observadas)
n_ab <- 500
# (3) Repetimos el experimento B veces:
#     - en cada repetición simulamos cuántos clicks ocurren en 500 personas
#     - luego dividimos por 500 para obtener la proporción p-hat
p_hat <- replicate(B, {
clicks <- rbinom(1, size = n_ab, prob = p_real)  # número de clicks
clicks / n_ab                                    # proporción de clicks (p-hat)
})
# (4) Error estándar teórico de p-hat:
#     Fórmula: SE(p̂) = sqrt( p(1-p) / n )
se_p <- sqrt(p_real * (1 - p_real) / n_ab)
cat("Resultado clave:\n")
cat("SE(p̂) = sqrt(p(1-p)/n)\n")
cat("Con p =", p_real, "y n =", n_ab, "-> SE teórico ≈", round(se_p, 4), "\n\n")
hist(p_hat, breaks = 40, probability = TRUE,
col = "gray80", border = "white",
main = "Distribución muestral de p̂",
xlab = "p̂")
abline(v = p_real, lty = 2, lwd = 2)
cat("✅ Fin. Ideas clave:\n")
cat("1) La media cambia si repites la muestra.\n")
cat("2) El tamaño típico de ese cambio es el SE.\n")
cat("3) SE baja cuando n sube.\n")
cat("4) TLC: las medias tienden a verse normales.\n")
ggplot(resultados, aes(x = media)) +
geom_histogram(aes(y = after_stat(density)),
bins = 50, fill = "gray80", color = "white") +
facet_wrap(~n, scales = "free") +
geom_vline(xintercept = mu_pop, linetype = "dashed") +
labs(title = "Cuando n aumenta: la media se vuelve más estable y más 'normal'",
x = "Media muestral (X̄)", y = "Densidad") +
theme_minimal(base_size = 12)
knitr::opts_chunk$set(echo = TRUE)
set.seed(2026)
N_pop <- 100000
pob_taller <- rlnorm(N_pop, meanlog = 10, sdlog = 1.2)
mu_pop <- mean(pob_taller)
# 1) Grafica la poblacion
hist(pob_taller, breaks=80, col="gray80", border="white",
main="Poblacion (log-normal)", xlab="Monto")
# 2) Completa: simula medias para n=10, 50, 200
B <- 5000
n <- 10
medias_10 <- replicate(B, mean(sample(pob_taller, n, replace=TRUE)))
n <- 50
medias_50 <- replicate(B, mean(sample(pob_taller, n, replace=TRUE)))
n <- 200
medias_200 <- replicate(B, mean(sample(pob_taller, n, replace=TRUE)))
