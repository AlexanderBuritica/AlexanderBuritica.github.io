###############################################################
# BA2 - Clase 5 (Taller en R)
# Tema: Estimación puntual, Intervalos de Confianza (IC) y Comunicación
# Objetivo: producir reportes ejecutivos (estimación + IC + n)
###############################################################
# =============================================================
# 0) SETUP
# =============================================================
rm(list = ls())
set.seed(123)  # para que a todos les salgan números similares
# (Opcional) si quieres usar dplyr para formatear:
# install.packages("dplyr")
# library(dplyr)
# =============================================================
# 1) PARTE A: MEDIA (PROMEDIO) - IC 95% PASO A PASO
# Caso: gasto mensual (en miles) de clientes
# =============================================================
# 1.1) Crear datos (simulados, fáciles)
n <- 40
gasto <- round(rnorm(n, mean = 280, sd = 64), 0)
# Ver los primeros datos
head(gasto)
# 1.2) Paso 1: calcular estimación puntual y dispersión
xbar <- mean(gasto)   # promedio muestral
S <- sd(gasto)        # desviación estándar muestral
SE <- S / sqrt(n)     # error estándar del promedio
xbar; S; SE
# 1.3) Paso 2: obtener valor crítico (t) para 95%
alpha <- 0.05
tcrit <- qt(1 - alpha/2, df = n - 1)
tcrit
ME <- tcrit * SE
IC_media <- c(xbar - ME, xbar + ME)
ME; IC_media
t.test(gasto, conf.level = 0.95)$conf.int
cat("\nREPORTE EJECUTIVO (MEDIA)\n")
cat("Gasto promedio:", round(xbar, 1),
"(IC 95%:", round(IC_media[1], 1), "a", round(IC_media[2], 1),
", n=", n, ")\n", sep = " ")
t.test(gasto, conf.level = 0.95)$conf.int
n <- 500
compras <- 40
phat <- compras / n   # proporción muestral (estimación)
phat
# 2.2) Paso 1: error estándar de la proporción (Wald)
SEp <- sqrt(phat * (1 - phat) / n)
SEp
# 2.3) Paso 2: valor crítico z para 95% (normal)
z <- qnorm(0.975)  # 1 - alpha/2 con alpha=0.05
z
1-(phat/2)
# 2.4) Paso 3: margen de error y IC (Wald)
MEp <- z * SEp
IC_wald <- c(phat - MEp, phat + MEp)
MEp; IC_wald
# 2.5) Checklist: ¿puedo usar Wald?
# Regla práctica: n*phat >= 10 y n*(1-phat) >= 10
exitos <- n * phat
fracasos <- n * (1 - phat)
exitos; fracasos
cat("\nREPORTE EJECUTIVO (PROPORCIÓN - WALD)\n")
cat("Conversión estimada:", round(100 * phat, 1), "% ",
"(IC 95%:", round(100 * IC_wald[1], 1), "% a", round(100 * IC_wald[2], 1),
"%, n=", n, ")\n", sep = "")
# 2.7) Comparar con métodos de R (más robustos)
IC_prop_test <- prop.test(compras, n, conf.level = 0.95)$conf.int
IC_prop_test
###############################################################
# BA2 - Clase 5 (Taller en R)
# Tema: Estimación puntual, Intervalos de Confianza (IC) y Comunicación
# Objetivo: producir reportes ejecutivos (estimación + IC + n)
###############################################################
# =============================================================
# 0) SETUP
# =============================================================
rm(list = ls())
set.seed(123)  # para que a todos les salgan números similares
# (Opcional) si quieres usar dplyr para formatear:
# install.packages("dplyr")
# library(dplyr)
# =============================================================
# 1) PARTE A: MEDIA (PROMEDIO) - IC 95% PASO A PASO
# Caso: gasto mensual (en miles) de clientes
# =============================================================
# 1.1) Crear datos (simulados, fáciles)
n <- 40
gasto <- round(rnorm(n, mean = 280, sd = 64), 0)
# Ver los primeros datos
head(gasto)
# 1.2) Paso 1: calcular estimación puntual y dispersión
xbar <- mean(gasto)   # promedio muestral
S <- sd(gasto)        # desviación estándar muestral
SE <- S / sqrt(n)     # error estándar del promedio
xbar; S; SE
# 1.3) Paso 2: obtener valor crítico (t) para 95%
alpha <- 0.05
tcrit <- qt(1 - alpha/2, df = n - 1)
tcrit
# 1.4) Paso 3: margen de error y el IC
ME <- tcrit * SE
IC_media <- c(xbar - ME, xbar + ME)
ME; IC_media
# 1.5) Validación rápida con función de R
t.test(gasto, conf.level = 0.95)$conf.int
# 1.6) Reporte ejecutivo (en una frase)
cat("\nREPORTE EJECUTIVO (MEDIA)\n")
cat("Gasto promedio:", round(xbar, 1),
"(IC 95%:", round(IC_media[1], 1), "a", round(IC_media[2], 1),
", n=", n, ")\n", sep = " ")
# =============================================================
# 2) PARTE B: PROPORCIÓN (CONVERSIÓN) - IC 95% PASO A PASO
# Caso: e-commerce (n visitas, compras)
# =============================================================
# 2.1) Datos del caso
n <- 500
compras <- 40
phat <- compras / n   # proporción muestral (estimación)
phat
# 2.2) Paso 1: error estándar de la proporción (Wald)
SEp <- sqrt(phat * (1 - phat) / n)
SEp
# 2.3) Paso 2: valor crítico z para 95% (normal)
#
# ¿Por qué usamos 0.975 en qnorm()?
#
# IDEA: Un IC del 95% deja el 95% "en el centro" de la distribución Normal.
# Entonces queda un 5% "por fuera" (error total).
#
# Paso A) Calcula el error total que queda fuera:
alpha <- 0.05          # porque 95% = 1 - 0.05
# Paso B) Como el IC es BILATERAL, ese 5% se reparte en DOS colas:
alpha_2 <- alpha / 2   # 0.05/2 = 0.025 = 2.5% en cada cola
# Paso C) Para encontrar el "corte" de la cola derecha, necesitamos
# el valor Z tal que a la IZQUIERDA quede 1 - 0.025 = 0.975 (97.5%).
p_acumulada <- 1 - alpha_2   # 1 - 0.025 = 0.975
# Paso D) qnorm(p) devuelve el valor Z donde la Normal estándar acumula p.
z <- qnorm(p_acumulada)      # qnorm(0.975) = 1.96 aprox.
z
# 2.4) Paso 3: margen de error y IC (Wald)
MEp <- z * SEp
IC_wald <- c(phat - MEp, phat + MEp)
MEp; IC_wald
# 2.5) Checklist: ¿puedo usar Wald?
# Regla práctica: n*phat >= 10 y n*(1-phat) >= 10
exitos <- n * phat
fracasos <- n * (1 - phat)
exitos; fracasos
# 2.6) Reporte ejecutivo (en porcentaje)
cat("\nREPORTE EJECUTIVO (PROPORCIÓN - WALD)\n")
cat("Conversión estimada:", round(100 * phat, 1), "% ",
"(IC 95%:", round(100 * IC_wald[1], 1), "% a", round(100 * IC_wald[2], 1),
"%, n=", n, ")\n", sep = "")
# 2.7) Comparar con métodos de R (más robustos)
# prop.test (aprox Wilson / score)
IC_prop_test <- prop.test(compras, n, conf.level = 0.95)$conf.int
IC_prop_test
IC_binom_exact <- binom.test(compras, n, conf.level = 0.95)$conf.int
IC_binom_exact
mu_real <- 280
sigma_real <- 64
n <- 40
B <- 2000  # repeticiones (puedes subir a 10000 si quieres)
contiene_mu <- replicate(B, {
x <- rnorm(n, mean = mu_real, sd = sigma_real)
ci <- t.test(x, conf.level = 0.95)$conf.int
(ci[1] <= mu_real) && (mu_real <= ci[2])
})
cobertura <- mean(contiene_mu)
cobertura
# 4.1) Datos del ejemplo
nA <- 1200; pA <- 0.062
nB <- 1200; pB <- 0.081
# 4.2) Paso 1: diferencia puntual
diff <- pB - pA
diff
# 4.3) Paso 2: error estándar de la diferencia
SEdiff <- sqrt(pA * (1 - pA) / nA + pB * (1 - pB) / nB)
SEdiff
# 4.4) Paso 3: margen de error (95%)
MEdiff <- qnorm(0.975) * SEdiff
MEdiff
# 4.5) Paso 4: IC 95% de la diferencia
IC_diff <- c(diff - MEdiff, diff + MEdiff)
IC_diff
cat("\nREPORTE EJECUTIVO (A/B)\n")
cat("Diferencia (B - A):", round(100 * diff, 2), "pp ",
"(IC 95%:", round(100 * IC_diff[1], 2), "pp a", round(100 * IC_diff[2], 2), "pp)\n", sep = "")
# 4.7) Interpretación automática (si incluye 0 o no)
if (IC_diff[1] <= 0 && IC_diff[2] >= 0) {
cat("Interpretación: el IC incluye 0 -> evidencia NO concluyente al 95%.\n")
} else if (IC_diff[1] > 0) {
cat("Interpretación: B parece MEJOR que A al 95%.\n")
} else {
cat("Interpretación: B parece PEOR que A al 95%.\n")
}
