"k12",
"k13",
"Áreatotalcacaoenarregloagroforestal",
"areatotalcacaoenarregloagroforestal"
)
# Detectar qué candidatas existen realmente en el dataset
detectar_vars <- function(candidatas, datos) {
nm       <- names(datos)
nm_lower <- tolower(nm)
encontradas <- map_chr(candidatas, function(v) {
if (v %in% nm) return(v)
idx <- which(nm_lower == tolower(v))
if (length(idx)) return(nm[idx[1]])
idx <- which(str_detect(nm_lower, fixed(tolower(v), ignore_case = TRUE)))
if (length(idx)) return(nm[idx[1]])
return(NA_character_)
})
tibble(candidata = candidatas, encontrada = encontradas) %>%
filter(!is.na(encontrada)) %>%
pull(encontrada) %>%
unique()
}
v_i1 <- detectar_vars(vars_i1_intensificacion, fincas_raw)
v_i2 <- detectar_vars(vars_i2_manejo,          fincas_raw)
v_i3 <- detectar_vars(vars_i3_agroforestal,    fincas_raw)
v_i4 <- detectar_vars(vars_i4_largo_plazo,     fincas_raw)
cat("\n=== Variables encontradas por índice ===\n")
cat("I1 Intensificación:", paste(v_i1, collapse=", "), "\n")
cat("I2 Manejo         :", paste(v_i2, collapse=", "), "\n")
cat("I3 Agroforestería :", paste(v_i3, collapse=", "), "\n")
cat("I4 Largo plazo    :", paste(v_i4, collapse=", "), "\n")
# =====================================================================
# 4. CONSTRUIR INDICADORES BINARIOS Y CALCULAR ÍNDICES
# =====================================================================
# Convierte cualquier variable de práctica a binario 0/1
# Maneja: labelled (haven/Stata), numérico, carácter Sí/No
binario <- function(x) {
if (is.numeric(x) || is.labelled(x)) {
x2   <- as.numeric(x)
lbls <- attr(x, "labels")
if (!is.null(lbls)) {
si_val <- lbls[tolower(names(lbls)) %in% c("sí","si","yes","1")]
if (length(si_val)) return(as.integer(x2 == si_val[1]))
}
return(as.integer(!is.na(x2) & x2 > 0))
}
if (is.character(x) || is.factor(x)) {
x2 <- tolower(as.character(x))
return(as.integer(str_detect(x2, "^s[íi]$|^yes$|^1$|^si$")))
}
rep(NA_integer_, length(x))
}
# Suma y proporción de prácticas adoptadas por finca
construir_indice <- function(datos, vars_encontradas, nombre_indice) {
if (length(vars_encontradas) == 0) {
message("Sin variables para ", nombre_indice)
return(datos %>%
mutate(!!paste0(nombre_indice,"_suma")   := NA_real_,
!!paste0(nombre_indice,"_prop")   := NA_real_,
!!paste0(nombre_indice,"_adopta") := NA_integer_))
}
mat    <- map_dfc(vars_encontradas, ~ tibble(!!.x := binario(datos[[.x]])))
n_vars <- ncol(mat)
suma   <- rowSums(mat, na.rm = TRUE)
n_obs  <- rowSums(!is.na(mat))
prop   <- ifelse(n_obs > 0, suma / n_obs, NA_real_)
adopta <- as.integer(suma >= ceiling(n_vars / 2))
datos %>%
mutate(
!!paste0(nombre_indice,"_suma")   := suma,
!!paste0(nombre_indice,"_prop")   := round(prop, 3),
!!paste0(nombre_indice,"_adopta") := adopta,
!!paste0(nombre_indice,"_n_vars") := n_obs
)
}
fincas_raw <- fincas_raw %>%
construir_indice(v_i1, "i1_intens") %>%
construir_indice(v_i2, "i2_manejo") %>%
construir_indice(v_i3, "i3_agro")   %>%
construir_indice(v_i4, "i4_lp")
cat("\n=== Resumen de índices (proporción media) ===\n")
fincas_raw %>%
summarise(across(ends_with("_prop"), ~ mean(.x, na.rm=TRUE))) %>%
print()
# =====================================================================
# 5. TABLA DE CORRESPONDENCIA: código encuesta → DANE municipal
#
# 'Municipio' en la encuesta tiene códigos secuenciales (1, 2, 3, …),
# no códigos DANE. La tabla fue verificada con: tab Municipio Departamento
# en Stata (N=3,396: 308 Caquetá + 3,088 Cesar).
# =====================================================================
crosswalk_mun <- tibble::tribble(
~cod_enc, ~dane,    ~nom_mun,
# --- CESAR (depto 20) ---
1L, "20001", "Valledupar",
2L, "20013", "Aguachica",
3L, "20032", "Agustín Codazzi",
6L, "20238", "El Copey",
7L, "20710", "San Alberto",
8L, "20228", "Curumaní",
10L, "20621", "La Paz",
11L, "20570", "Pueblo Bello",
12L, "20400", "La Jagua de Ibirico",
13L, "20178", "Chiriguaná",
15L, "20690", "San Martín",
17L, "20550", "Pailitas",
19L, "20443", "Manaure",
20L, "20614", "Río de Oro",
23L, "20660", "San Diego",
25L, "20310", "González",
# --- CAQUETÁ (depto 18) ---
26L, "18094", "Belén de los Andaquíes",
27L, "18247", "El Doncello",
28L, "18256", "El Paujil",
29L, "18001", "Florencia",
30L, "18410", "La Montañita",
31L, "18592", "Puerto Rico",
32L, "18610", "San José del Fragua",
33L, "18753", "San Vicente del Caguán",
34L, "18785", "Solita",
35L, "18860", "Valparaíso",
36L, "18205", "Curillo"
)
# Verificar cobertura completa
cod_enc_todos <- sort(unique(as.integer(fincas_raw$Municipio)))
sin_mapeo     <- setdiff(cod_enc_todos, crosswalk_mun$cod_enc)
if (length(sin_mapeo)) {
cat("\n⚠ Códigos sin DANE asignado:", paste(sin_mapeo, collapse=", "),
"\n  Añade las filas en crosswalk_mun\n")
} else {
cat("\nTodos los códigos de municipio tienen DANE asignado.\n")
}
# =====================================================================
# 6. CONSTRUIR BASE ANALÍTICA
# =====================================================================
viol_muni_exp <- readRDS(file.path(out_proc, "violencia_muni_exposicion.rds"))
fincas_exp    <- try(readRDS(file.path(out_proc, "fincas_exposicion.rds")), silent = TRUE)
rendimiento <- read_dta(ruta_rendimiento) %>%
select(cedula, cacaoyielddrykgha) %>%
filter(!is.na(cedula), !is.na(cacaoyielddrykgha), cacaoyielddrykgha > 0)
col_aptitud_finca <- names(fincas_raw)[
str_detect(tolower(names(fincas_raw)), "aptitud")
][1]
# Detectar campo de municipio ANTES del pipe (evita error con names(.))
campo_mun_enc <- names(fincas_raw)[
tolower(names(fincas_raw)) %in% c("municipio","cod_mun","mpio","mpio_cod",
"cod_municipio","dane")
][1]
if (is.na(campo_mun_enc)) {
cat("Campos con 'mun'/'mpio' disponibles:\n")
print(names(fincas_raw)[str_detect(tolower(names(fincas_raw)), "mun|mpio|munic")])
stop("Campo de municipio no encontrado. Asigna 'campo_mun_enc' manualmente.")
}
message("Campo municipio: '", campo_mun_enc, "'")
base_analisis <- fincas_raw %>%
filter(!is.na(Latitud), !is.na(Longitud),
between(Longitud, -79, -66), between(Latitud, -4.5, 13.6)) %>%
mutate(cod_enc_int = as.integer(.data[[campo_mun_enc]])) %>%
left_join(crosswalk_mun, by = c("cod_enc_int" = "cod_enc")) %>%
mutate(
cod_mun_enc = dane,
cod_dep_enc = str_sub(cod_mun_enc, 1, 2)
) %>%
filter(!is.na(cod_mun_enc), cod_dep_enc %in% DEPTOS) %>%
left_join(viol_muni_exp, by = c("cod_mun_enc" = "dane")) %>%
mutate(across(c(viol_total_hist, eventos_hist, viol_5a, viol_post16),
~ replace_na(., 0L))) %>%
left_join(rendimiento, by = "cedula")
message("Fincas tras crosswalk: ", nrow(base_analisis))
n_excluidas <- sum(
is.na(fincas_raw$Municipio) |
!(as.integer(fincas_raw$Municipio) %in% crosswalk_mun$cod_enc)
)
cat("Fincas excluidas (sin DANE):", n_excluidas, "\n")
# Añadir buffers de violencia si están disponibles
if (!inherits(fincas_exp, "try-error")) {
buf_cols <- names(fincas_exp)[str_detect(names(fincas_exp), "^viol_[0-9]+km")]
base_analisis <- base_analisis %>%
left_join(fincas_exp %>% select(cedula, all_of(buf_cols)), by = "cedula")
message("Buffers de violencia unidos desde fincas_exposicion.rds")
} else {
message("fincas_exposicion.rds no disponible — ejecuta 02_predios_fincas_mapa.R primero.")
base_analisis$viol_5km_hist  <- NA_real_
base_analisis$viol_10km_hist <- NA_real_
}
# Categoría de violencia (terciles municipales)
base_analisis <- base_analisis %>%
mutate(
depto    = dep_lab[cod_dep_enc],
viol_cat = cut(viol_total_hist,
breaks = quantile(viol_total_hist, probs=c(0,1/3,2/3,1), na.rm=TRUE),
labels = c("Baja","Media","Alta"),
include.lowest = TRUE),
viol_cat = factor(viol_cat, levels = c("Baja","Media","Alta"))
)
if (!is.na(col_aptitud_finca)) {
base_analisis <- base_analisis %>%
mutate(aptitud = factor(.data[[col_aptitud_finca]], levels = niveles_apt))
} else {
base_analisis$aptitud <- NA_character_
message("'aptitud' no encontrada en encuesta — une desde 02_predios_fincas_mapa.R por cedula.")
}
message("Base analítica final: ", nrow(base_analisis), " fincas")
cat("Por departamento:\n"); print(table(base_analisis$depto))
cat("Por violencia:\n");    print(table(base_analisis$viol_cat, useNA="ifany"))
