cat("\n\n💼 CASO 3: EXPERIENCIA → SALARIO\n")
salarios_exp <- data.frame(
experiencia = c(0,1,1,2,2,3,4,5,5,6,7,8,9,10,12,15,
0.5,1.5,3,4.5,6.5,8.5,11,13,14,2.5),
salario     = NA_real_
)
salarios_exp$salario <- round(2200 + 320*salarios_exp$experiencia + rnorm(nrow(salarios_exp),0,400), 0)
View(salarios_exp)
mod3 <- analizar_regresion(salarios_exp, "experiencia", "salario",
"Años de experiencia → Salario mensual (miles COP)",
x_lab="Años de experiencia", y_lab="Salario mensual (miles COP)",
pred_x=7, color_pts="#0D7377", color_line="tomato")
View(salarios_exp)
# Aplicación práctica: ¿mi salario es justo?
cat("\nHerramienta de negociación salarial:\n")
b_sal <- coef(mod3)
for(anios in c(2,5,8,12,15)) {
esperado <- b_sal[1]+b_sal[2]*anios
cat(sprintf("  %2.0f años experiencia → salario esperado: $%s K COP/mes\n",
anios, format(round(esperado,0), big.mark=",")))
}
2738*1000000
View(salarios_exp)
View(salarios_exp)
