hist(poblacion, breaks = 80, col = "steelblue", border = "white",
main = "Distribucion de la poblacion (exponencial)",
xlab = "Tiempo de entrega (min)", probability = TRUE)
#══════════════════════════════════════════════════════════════
# PASO 2: UNA SOLA MUESTRA
# ══════════════════════════════════════════════════════════════
# Tomar UNA muestra de tamano n = 50
n <- 50
set.seed(2026)  # Reproducibilidad
una_muestra <- sample(poblacion, size = n)
una_muestra
# Calcular estadisticos
x_bar <- mean(una_muestra)
s     <- sd(una_muestra)
se    <- s / sqrt(n)
cat("Media muestral:", round(x_bar, 2), "\n")
cat("Desv. estandar muestral:", round(s, 2), "\n")
cat("Error estandar:", round(se, 2), "\n")
# ══════════════════════════════════════════════════════════════
# PASO 3: MUCHAS MUESTRAS
# ══════════════════════════════════════════════════════════════
# Tomar 10,000 muestras de tamano n y calcular la media de cada una
medias <- replicate(n_simulaciones, {
muestra <- sample(poblacion, size = n)
mean(muestra)
})
# Verificar propiedades teoricas
cat("Media de las medias:", round(mean(medias), 2),
" (teorico:", round(mu_real, 2), ")\n")
cat("SD de las medias:", round(sd(medias), 2),
" (teorico SE:", round(sigma_real/sqrt(n), 2), ")\n")
#% ══════════════════════════════════════════════════════════════
#% PASO 4: VISUALIZAR EL TLC
#% ══════════════════════════════════════════════════════════════
# Histograma de medias muestrales + curva normal teorica
hist(medias, breaks = 60, col = "steelblue", border = "white",
probability = TRUE,
main = paste("Distribucion muestral de X-bar (n =", n, ")"),
xlab = "Media muestral")
# Superponer la curva normal teorica
curve(dnorm(x, mean = mu_real, sd = sigma_real/sqrt(n)),
col = "red", lwd = 2, add = TRUE)
# Linea vertical en la media poblacional
abline(v = mu_real, col = "darkred", lwd = 2, lty = 2)
legend("topright", legend = c("Normal teorica", "mu real"),
col = c("red", "darkred"), lwd = 2, lty = c(1, 2))
#El histograma de las 10{,}000 medias se ajusta \textbf{muy bien} a la curva normal, a pesar de que la población original es exponencial.
#% ══════════════════════════════════════════════════════════════
#% PASO 5: EFECTO DE n
#% ══════════════════════════════════════════════════════════════
# Comparar distintos tamanos de muestra
tamanos <- c(5, 15, 30, 50, 100, 500)
par(mfrow = c(2, 3))  # Panel 2x3
for (n_i in tamanos) {
medias_i <- replicate(n_simulaciones, mean(sample(poblacion, n_i)))
hist(medias_i, breaks = 50, col = "steelblue", border = "white",
probability = TRUE, main = paste("n =", n_i),
xlab = "Media muestral", xlim = c(0, 80))
curve(dnorm(x, mu_real, sigma_real/sqrt(n_i)),
col = "red", lwd = 2, add = TRUE)
}
par(mfrow = c(1, 1))  # Restaurar
# Version con ggplot2 (mas elegante)
resultados <- data.frame()
for (n_i in c(5, 30, 100, 500)) {
medias_i <- replicate(n_simulaciones, mean(sample(poblacion, n_i)))
resultados <- rbind(resultados,
data.frame(n = paste("n =", n_i), media = medias_i))
}
resultados$n <- factor(resultados$n,
levels = c("n = 5", "n = 30", "n = 100", "n = 500"))
ggplot(resultados, aes(x = media)) +
geom_histogram(aes(y = after_stat(density)),
bins = 50, fill = "steelblue", color = "white", alpha = 0.7) +
stat_function(fun = dnorm,
args = list(mean = mu_real, sd = sigma_real/sqrt(5)),
color = "red", linewidth = 1, data = subset(resultados, n == "n = 5")) +
facet_wrap(~n, scales = "free") +
geom_vline(xintercept = mu_real, color = "darkred", linetype = "dashed") +
labs(title = "TLC: Convergencia a la normal",
x = "Media muestral", y = "Densidad") +
theme_minimal()
