print(
knitr::kable(tabla_cat, format = "html") %>%
kableExtra::kable_styling(full_width = FALSE, font_size = 16,
bootstrap_options = c("striped", "hover", "condensed"))
)
}
} # cierre for(tema)
} # 🔚 cierre for(clust_var)
prueba_cluster <- function(data, var, clust = "clust_m3_5_") {
f <- as.formula(paste(var, "~ as.factor(", clust, ")"))
cat("\n===", var, "===\n")
print(
data %>%
dplyr::filter(!is.na(.data[[clust]]), !is.na(.data[[var]])) %>%
dplyr::group_by(.data[[clust]]) %>%
dplyr::summarise(
n = dplyr::n(),
mean = mean(.data[[var]], na.rm = TRUE),
.groups = "drop"
)
)
cat("\nKruskal–Wallis:\n")
print(kruskal.test(f, data = data))
}
# Ejemplo:
prueba_cluster(df, "conser_agua_suelo", "clust_m3_5_")
prueba_cluster(df, "fertilizante_organico", "clust_m3_5_")
prueba_cluster(df, "variedad_castillo", "clust_m3_5_")
