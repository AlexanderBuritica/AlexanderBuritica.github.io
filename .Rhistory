#
# =============================================================================
# --- BLOQUE DE DATOS (no modificar) -----------------------------------------
set.seed(303)
n <- 80
# CASO A: Nequi
nequi_reg <- data.frame(
saldo        = round(runif(n, min=50, max=2000), 0),
transacciones = NA_integer_
)
nequi_reg$transacciones <- round(pmax(
5 + 0.018 * nequi_reg$saldo + rnorm(n, 0, 4), 1
))
View(nequi_reg)
# CASO B: BikeBog
bikebog_reg <- data.frame(
distancia_km = round(runif(n, min=0.5, max=15), 1),
minutos_uso  = NA_real_
)
bikebog_reg$minutos_uso <- round(pmax(
45 - 2.1 * bikebog_reg$distancia_km + rnorm(n, 0, 8), 5
), 1)
View(bikebog_reg)
colnames(nequi_reg)
# A1. Visualización inicial (1 pts)
# Genera un scatter plot de saldo vs transacciones
library(ggplot2)
ggplot(nequi_reg, aes(x=saldo, y=transacciones)) +
geom_point(color="#2C3E8C", alpha=0.7) +
geom_smooth(method="lm", color="tomato", se=TRUE) +
labs(title="Nequi: Saldo → Transacciones mensuales",
x="Saldo promedio (miles COP)", y="Transacciones por mes") +
theme_minimal()
mod_nequi <- lm(transacciones ~ saldo, data = nequi_reg)
summary(mod_nequi)
b0_nequi <- round(coef(mod_nequi)[1], 4)
b1_nequi <- round(coef(mod_nequi)[2], 4)
r2_nequi <- round(summary(mod_nequi)$r.squared, 4)
p_nequi  <- summary(mod_nequi)$coefficients[2, 4]
cat("Ecuación: transacciones =", b0_nequi, "+", b1_nequi, "× saldo\n")
cat("R²       :", r2_nequi, "\n")
cat("p-value β₁:", format(p_nequi, scientific=TRUE), "\n")
View(nequi_reg)
0.0182*100000
View(nequi_reg)
0.0182*1000
yhat_500 <- b0_nequi + b1_nequi *5000
cat("Predicción (saldo=$500K):", round(yhat_500, 1), "transacciones/mes\n")
colnames(bikebog_reg)
# B1. Estima el modelo (2 pt)
mod_bike <- lm(minutos_uso ~ distancia_km, data = bikebog_reg)
summary(mod_bike)
b1_bike <- round(coef(mod_bike)[2], 4)
r2_bike <- round(summary(mod_bike)$r.squared, 4)
p_bike  <- summary(mod_bike)$coefficients[2, 4]
cat("β₁ =", b1_bike, "| p =", round(p_bike, 4), "\n")
# Predicción: ¿cuántos minutos de uso se esperan en una estación a 8 km del centro?
b0_bike <- coef(mod_bike)[1]
pred_8km <- ___ + ___ * 8
# Predicción: ¿cuántos minutos de uso se esperan en una estación a 8 km del centro?
b0_bike <- coef(mod_bike)[1]
pred_8km <- 44.64 + -2.1645 * 8
cat("Predicción (8 km del centro):", round(pred_8km, 1), "minutos/día\n")
rmarkdown::render_site()
