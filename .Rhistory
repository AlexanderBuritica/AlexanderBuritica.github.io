# CONTEXTO – TRES MINI-CASOS
# =============================================================================
#
# CASO A · Nequi / Plataforma de pagos
#   ¿El saldo promedio de la cuenta (X, miles COP) predice el número de
#   transacciones mensuales (Y)?
#
# CASO B · BikeBog – Infraestructura ciclística
#   ¿La distancia al centro de la ciudad (X, km) predice el tiempo de
#   uso diario de las estaciones de bici (Y, minutos)?
#
# CASO C · Plataforma de cursos online (Platzi / Coursera Colombia)
#   ¿El número de horas de contenido del curso (X) predice la tasa de
#   completación por parte de los usuarios (Y, %)?
# =============================================================================
# --- BLOQUE DE DATOS (no modificar) -----------------------------------------
set.seed(303)
n <- 80
# CASO A: Nequi
nequi_reg <- data.frame(
saldo        = round(runif(n, min=50, max=2000), 0),
transacciones = NA_integer_
)
nequi_reg$transacciones <- round(pmax(
5 + 0.018 * nequi_reg$saldo + rnorm(n, 0, 4), 1
))
# CASO B: BikeBog
bikebog_reg <- data.frame(
distancia_km = round(runif(n, min=0.5, max=15), 1),
minutos_uso  = NA_real_
)
bikebog_reg$minutos_uso <- round(pmax(
45 - 2.1 * bikebog_reg$distancia_km + rnorm(n, 0, 8), 5
), 1)
# CASO C: Cursos online
cursos <- data.frame(
horas_contenido = round(runif(n, min=2, max=40), 1),
completacion    = NA_real_
)
cursos$completacion <- round(pmax(pmin(
85 - 1.2 * cursos$horas_contenido + rnorm(n, 0, 10), 100
), 10), 1)
