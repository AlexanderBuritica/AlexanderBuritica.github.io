# CASO 2 📣 · INVERSIÓN EN PUBLICIDAD → VENTAS
# =============================================================================
cat("\n\n📣 CASO 2: PUBLICIDAD → VENTAS\n")
publicidad <- data.frame(
presupuesto = c(5,8,10,12,15,18,20,22,25,28,30,32,35,38,40,
6,11,14,17,21,24,27,31,36,42),
ventas      = NA_real_
)
publicidad$ventas <- round(80 + 12*publicidad$presupuesto + rnorm(nrow(publicidad),0,35), 1)
View(publicidad)
View(publicidad)
mod2 <- analizar_regresion(publicidad, "presupuesto", "ventas",
"Presupuesto publicidad (M COP) → Ventas (M COP)",
x_lab="Inversión en publicidad (M COP)", y_lab="Ventas (M COP)",
pred_x=25, color_pts="#5C3D8F", color_line="#C2410C")
cat("\n¿Vale la pena aumentar el presupuesto de $20M a $30M?\n")
b_pub <- coef(mod2)
cat(sprintf("  Ventas con $20M: $%.1fM\n", b_pub[1]+b_pub[2]*20))
cat(sprintf("  Ventas con $30M: $%.1fM\n", b_pub[1]+b_pub[2]*30))
cat(sprintf("  Incremento ventas: $%.1fM por $10M adicionales → ROI %.1fx\n",
(b_pub[2]*10), b_pub[2]))
107.8/10
