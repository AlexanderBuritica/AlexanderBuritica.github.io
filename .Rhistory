}
# Distancia promedio a vecinos
results[[paste0("dist_avg_k", k)]] <- apply(dist, 1, mean)
return(as.data.frame(results))
}
# --- 2.4 Calcular para k=3, k=5 (verificación), k=10 ---
k_values <- c(3, 5, 10)
all_exposures <- data.frame(nuevo_id = df_gps$nuevo_id)
for (k in k_values) {
cat(sprintf("\n=== Calculando exposición IDW para k=%d ===\n", k))
exp_k <- compute_idw_exposure(df_gps, k)
all_exposures <- cbind(all_exposures, exp_k)
cat(sprintf("  Completado. %d variables generadas.\n", ncol(exp_k)))
}
# --- 2.5 Estadísticas descriptivas ---
cat("\n=== Estadísticas descriptivas de exposiciones ===\n")
exp_vars <- grep("^exp_k[0-9]+_", names(all_exposures), value = TRUE)
for (v in exp_vars) {
x <- all_exposures[[v]]
cat(sprintf("  %s: mean=%.3f, sd=%.3f, min=%.3f, max=%.3f, N=%d\n",
v, mean(x, na.rm = TRUE), sd(x, na.rm = TRUE),
min(x, na.rm = TRUE), max(x, na.rm = TRUE), sum(!is.na(x))))
}
# --- 2.6 Correlaciones entre k ---
cat("\n=== Correlaciones entre valores de k (estabilidad) ===\n")
for (av in adopt_vars) {
cat(sprintf("\n--- %s ---\n", av))
cols <- paste0("exp_k", k_values, "_", av)
cols_exist <- cols[cols %in% names(all_exposures)]
if (length(cols_exist) > 1) {
cor_mat <- cor(all_exposures[cols_exist], use = "complete.obs")
colnames(cor_mat) <- paste0("k=", k_values[1:ncol(cor_mat)])
rownames(cor_mat) <- paste0("k=", k_values[1:nrow(cor_mat)])
print(round(cor_mat, 3))
}
}
# --- 2.7 Distancias promedio ---
cat("\n=== Distancias promedio a vecinos (en grados) ===\n")
for (k in k_values) {
d <- all_exposures[[paste0("dist_avg_k", k)]]
# Conversión aproximada: 1 grado ≈ 111 km en Ecuador, ~100 km en Colombia
cat(sprintf("  k=%d: mean=%.4f grados (≈ %.1f km), sd=%.4f, max=%.4f (≈ %.1f km)\n",
k, mean(d, na.rm = TRUE), mean(d, na.rm = TRUE) * 100,
sd(d, na.rm = TRUE),
max(d, na.rm = TRUE), max(d, na.rm = TRUE) * 100))
}
# --- 2.8 Reconstruir clusters para k=3 y k=10 ---
cat("\n=== Reconstruyendo clusters MFA/HCPC para k=3 y k=10 ===\n")
for (k in c(3, 10)) {
cat(sprintf("\n--- k=%d ---\n", k))
# Variables de exposición para este k
exp_k_vars <- paste0("exp_k", k, "_", adopt_vars)
# Verificar que las variables existen en all_exposures
cat(sprintf("  Variables buscadas: %s\n", paste(exp_k_vars, collapse = ", ")))
missing_vars <- exp_k_vars[!exp_k_vars %in% names(all_exposures)]
if (length(missing_vars) > 0) {
cat(sprintf("  ERROR: Variables no encontradas en all_exposures: %s\n",
paste(missing_vars, collapse = ", ")))
cat(sprintf("  Variables disponibles: %s\n",
paste(grep(paste0("k", k), names(all_exposures), value = TRUE), collapse = ", ")))
next
}
# Merge con df_gps (usar solo nuevo_id y las variables de este k)
cols_to_merge <- c("nuevo_id", exp_k_vars)
df_k <- df_gps %>%
left_join(all_exposures[, cols_to_merge, drop = FALSE], by = "nuevo_id") %>%
drop_na(all_of(exp_k_vars))
cat(sprintf("  N con datos completos: %d\n", nrow(df_k)))
# PCA
pca_k <- PCA(df_k[, exp_k_vars], scale.unit = TRUE, ncp = 3, graph = FALSE)
cat("  Eigenvalues:\n")
print(round(pca_k$eig, 3))
# HCPC con 3 clusters
hcpc_k <- HCPC(pca_k, nb.clust = 3, graph = FALSE)
cat("  Distribución de clusters:\n")
print(table(hcpc_k$data.clust$clust))
# Guardar asignación de clusters
clust_name <- paste0("clust_k", k)
df_k[[clust_name]] <- as.integer(hcpc_k$data.clust$clust)
# Medias de exposición por cluster
cat("  Medias de exposición por cluster:\n")
means_k <- df_k %>%
group_by(!!sym(clust_name)) %>%
summarise(across(all_of(exp_k_vars), ~ round(mean(.x, na.rm = TRUE), 3)),
N = n(), .groups = "drop")
print(as.data.frame(means_k))
# Silhouette
sil_k <- silhouette(as.integer(hcpc_k$data.clust$clust), dist(pca_k$ind$coord))
cat(sprintf("  Average silhouette width: %.4f\n", mean(sil_k[, "sil_width"])))
# Exportar clusters para merge en Stata
export_k <- df_k[, c("nuevo_id", clust_name)]
write_dta(export_k, file.path(proc_dir, sprintf("clusters_k%d.dta", k)))
cat(sprintf("  >>> Exportado: %s\n", file.path(proc_dir, sprintf("clusters_k%d.dta", k))))
}
# --- 2.9 Exportar todas las exposiciones ---
write_dta(all_exposures, file.path(proc_dir, "exposure_indices_k3_k5_k10.dta"))
write.csv(all_exposures, file.path(proc_dir, "exposure_indices_k3_k5_k10.csv"), row.names = FALSE)
cat(sprintf("\n>>> Exposiciones guardadas: %s\n", file.path(proc_dir, "exposure_indices_k3_k5_k10.dta")))
# =============================================================
# RESUMEN FINAL
# =============================================================
cat("\n\n")
cat("================================================================\n")
cat("  RESUMEN: ARCHIVOS GENERADOS\n")
cat("================================================================\n")
cat("\nPara Appendix A:\n")
cat(sprintf("  Tablas:  %s/AppendixA_eigenvalues.csv\n", out_tab))
cat(sprintf("  Tablas:  %s/AppendixA_cluster_validation.csv\n", out_tab))
cat(sprintf("  Tablas:  %s/AppendixA_exposure_correlations.csv\n", out_tab))
cat(sprintf("  Figuras: %s/FigA1_dendrogram.png\n", out_fig))
cat(sprintf("  Figuras: %s/FigA2_factormap_pub.png\n", out_fig))
cat(sprintf("  Figuras: %s/FigA3_silhouette.png\n", out_fig))
cat("\nPara Robustness (k=3, k=10):\n")
cat(sprintf("  Datos:   %s/exposure_indices_k3_k5_k10.dta\n", proc_dir))
cat(sprintf("  Datos:   %s/clusters_k3.dta\n", proc_dir))
cat(sprintf("  Datos:   %s/clusters_k10.dta\n", proc_dir))
cat("\nSiguientes pasos en Stata:\n")
cat("  1. merge 1:1 nuevo_id using clusters_k3.dta, keep(master match) nogen\n")
cat("  2. merge 1:1 nuevo_id using clusters_k10.dta, keep(master match) nogen\n")
cat("  3. Crear dummies: tab clust_k3, gen(cl_k3_) y tab clust_k10, gen(cl_k10_)\n")
cat("  4. Correr MVP con cl_k3_2 cl_k3_3 y cl_k10_2 cl_k10_3\n")
cat("================================================================\n")
# =============================================================
# 04_Appendix_and_Robustness_R.R
#
# Objetivo:
#   PARTE 1 - Extraer valores para Appendix A (eigenvalues,
#             silhouette, dendrograma, factor map)
#   PARTE 2 - Generar índices de exposición k=3 y k=10 y
#             reconstruir clusters para robustness check
#
# Prerequisito: Correr primero el código base
#   coffee_clustering_excl4vars_v03.Rmd (o las secciones de
#   carga de datos y creación de variables)
#
# Autor: Alexander Buriticá
# Fecha: Abril 2026
# =============================================================
# --- Librerías ---
library(FactoMineR)
library(factoextra)
library(cluster)
library(dplyr)
library(tidyr)
library(readxl)
library(haven)
library(ggplot2)
library(FNN)
library(sf)
# --- PATHS (ajustar a tu máquina) ---
raw_dir   <- "D:/OneDrive - CGIAR/2026--Coffee Netw paper/1_Data/1_Raw"
proc_dir  <- "D:/OneDrive - CGIAR/2026--Coffee Netw paper/1_Data/2_Processed"
out_tab   <- "D:/OneDrive - CGIAR/2026--Coffee Netw paper/3_Results/1_Tables"
out_fig   <- "D:/OneDrive - CGIAR/2026--Coffee Netw paper/3_Results/2_Figures"
dir.create(out_tab, showWarnings = FALSE, recursive = TRUE)
dir.create(out_fig, showWarnings = FALSE, recursive = TRUE)
# =============================================================
# 0. CARGAR DATOS (replica tu código base)
# =============================================================
cat("=== Cargando datos ===\n")
data_alejandra <- read_stata(file.path(raw_dir, "data_alejandra_VARS"))
M3_5km <- read_excel(file.path(raw_dir, "M3_5km.xlsx"))
# Unión principal (solo necesitamos m3_5 para el paper)
df <- inner_join(data_alejandra, M3_5km, by = "nuevo_id")
cat(sprintf("Base cargada: %d observaciones, %d variables\n", nrow(df), ncol(df)))
# =============================================================
# PARTE 1: EXTRAER VALORES PARA APPENDIX A
# =============================================================
cat("\n\n")
cat("================================================================\n")
cat("  PARTE 1: VALORES PARA APPENDIX A (MFA/HCPC)\n")
cat("================================================================\n\n")
# --- 1.1 Variables de exposición ---
vars_exposure <- c("m3_5_conser_agua_suelo",
"m3_5_variedad_castillo",
"m3_5_fertilizante_organico")
# Verificar que existen
stopifnot(all(vars_exposure %in% names(df)))
# Convertir a numérico
df[vars_exposure] <- lapply(df[vars_exposure], function(x) as.numeric(as.character(x)))
# Filtrar NAs
df_complete <- df %>% drop_na(all_of(vars_exposure))
cat(sprintf("Observaciones completas: %d de %d\n", nrow(df_complete), nrow(df)))
# --- 1.2 PCA (tu código usa PCA, no MFA, porque son 3 variables continuas) ---
# NOTA: Tu función procesar_cluster() usa FactoMineR::PCA, no MFA.
# Esto es correcto porque tienes solo variables continuas.
# En el paper lo llamamos MFA por convención, pero el objeto es PCA.
pca_result <- PCA(df_complete[, vars_exposure], scale.unit = TRUE, ncp = 3, graph = FALSE)
# --- 1.3 EIGENVALUES (PLACEHOLDER #1) ---
cat("\n--- EIGENVALUES (para Table A1 del Appendix) ---\n")
eig_table <- as.data.frame(pca_result$eig)
colnames(eig_table) <- c("Eigenvalue", "Variance_pct", "Cumulative_pct")
eig_table$Dimension <- paste0("Dim ", 1:nrow(eig_table))
eig_table <- eig_table[, c("Dimension", "Eigenvalue", "Variance_pct", "Cumulative_pct")]
print(eig_table)
# Guardar como CSV
write.csv(eig_table, file.path(out_tab, "AppendixA_eigenvalues.csv"), row.names = FALSE)
cat("\n>>> Guardado en:", file.path(out_tab, "AppendixA_eigenvalues.csv"), "\n")
# --- 1.4 PCA Contributions ---
cat("\n--- CONTRIBUCIONES DE VARIABLES ---\n")
contrib <- as.data.frame(pca_result$var$contrib)
contrib$Variable <- rownames(contrib)
contrib$Total_Contrib <- rowSums(contrib[, grepl("^Dim", colnames(contrib))])
print(contrib[, c("Variable", "Dim.1", "Dim.2", "Dim.3", "Total_Contrib")])
# --- 1.5 PCA Loadings (correlaciones variable-dimensión) ---
cat("\n--- LOADINGS (correlaciones variable-dimensión) ---\n")
loadings <- as.data.frame(pca_result$var$cor)
loadings$Variable <- rownames(loadings)
print(loadings)
# --- 1.6 HCPC con nb.clust = 3 (como en tu código) ---
cat("\n--- HCPC (clustering) ---\n")
hcpc_result <- HCPC(pca_result, nb.clust = 3, graph = FALSE)
# Verificar clusters
cat("\nDistribución de clusters:\n")
print(table(hcpc_result$data.clust$clust))
# --- 1.7 BETWEEN/TOTAL INERTIA (PLACEHOLDER #2) ---
cat("\n--- INERTIA RATIO (para Table A2 del Appendix) ---\n")
# Calcular inercia manualmente
coords <- pca_result$ind$coord
clusters <- hcpc_result$data.clust$clust
# Inercia total
centroid_global <- colMeans(coords)
total_inertia <- sum(apply(coords, 1, function(x) sum((x - centroid_global)^2)))
# Inercia within
within_inertia <- 0
for (k in unique(clusters)) {
idx <- which(clusters == k)
centroid_k <- colMeans(coords[idx, , drop = FALSE])
within_inertia <- within_inertia + sum(apply(coords[idx, , drop = FALSE], 1,
function(x) sum((x - centroid_k)^2)))
}
between_inertia <- total_inertia - within_inertia
inertia_ratio <- between_inertia / total_inertia
cat(sprintf("Total inertia:   %.4f\n", total_inertia))
cat(sprintf("Between inertia: %.4f\n", between_inertia))
cat(sprintf("Within inertia:  %.4f\n", within_inertia))
cat(sprintf("Between/Total:   %.4f (%.1f%%)\n", inertia_ratio, inertia_ratio * 100))
# --- 1.8 SILHOUETTE WIDTH (PLACEHOLDER #3) ---
cat("\n--- SILHOUETTE WIDTH (para Table A2 del Appendix) ---\n")
# Calcular distancias en el espacio PCA
dist_matrix <- dist(coords)
sil <- silhouette(as.integer(clusters), dist_matrix)
avg_sil <- mean(sil[, "sil_width"])
cat(sprintf("Average silhouette width: %.4f\n", avg_sil))
cat(sprintf("Interpretación: %s\n",
ifelse(avg_sil > 0.50, "Estructura fuerte",
ifelse(avg_sil > 0.25, "Estructura razonable",
"Estructura débil"))))
# Silhouette por cluster
cat("\nSilhouette promedio por cluster:\n")
sil_by_cluster <- aggregate(sil[, "sil_width"],
by = list(Cluster = sil[, "cluster"]),
FUN = mean)
colnames(sil_by_cluster) <- c("Cluster", "Avg_Silhouette")
print(sil_by_cluster)
# Guardar tabla de validación
validation_table <- data.frame(
Statistic = c("Number of clusters",
"Cluster sizes",
"Total inertia",
"Between-cluster inertia",
"Within-cluster inertia",
"Between/Total inertia ratio",
"Average silhouette width",
paste0("Silhouette C", 1:3)),
Value = c("3",
paste(table(clusters), collapse = " / "),
sprintf("%.4f", total_inertia),
sprintf("%.4f", between_inertia),
sprintf("%.4f", within_inertia),
sprintf("%.4f (%.1f%%)", inertia_ratio, inertia_ratio * 100),
sprintf("%.4f", avg_sil),
sprintf("%.4f", sil_by_cluster$Avg_Silhouette))
)
write.csv(validation_table, file.path(out_tab, "AppendixA_cluster_validation.csv"), row.names = FALSE)
cat("\n>>> Guardado en:", file.path(out_tab, "AppendixA_cluster_validation.csv"), "\n")
# --- 1.9 DENDROGRAMA (PLACEHOLDER #4) ---
cat("\n--- Generando dendrograma ---\n")
png(file.path(out_fig, "FigA1_dendrogram.png"), width = 2400, height = 1600, res = 200)
plot(hcpc_result, choice = "tree",
title = "Dendrogram: HCPC on PCA components (k=5 neighbors)")
dev.off()
cat(">>> Guardado en:", file.path(out_fig, "FigA1_dendrogram.png"), "\n")
# --- 1.10 FACTOR MAP (PLACEHOLDER #5) ---
cat("\n--- Generando factor map ---\n")
png(file.path(out_fig, "FigA2_factormap.png"), width = 2400, height = 2000, res = 200)
plot(hcpc_result, choice = "map",
title = "Cluster map on first two PCA dimensions")
dev.off()
cat(">>> Guardado en:", file.path(out_fig, "FigA2_factormap.png"), "\n")
# También generar con fviz_cluster (más limpio para publicación)
p_cluster <- fviz_cluster(hcpc_result,
repel = TRUE,
geom = "point",
ellipse.type = "convex",
palette = c("#1b9e77", "#d95f02", "#7570b3"),
ggtheme = theme_minimal(base_size = 14)) +
labs(title = "Exposure clusters projected on PCA dimensions",
x = sprintf("Dim 1 (%.1f%%)", pca_result$eig[1, 2]),
y = sprintf("Dim 2 (%.1f%%)", pca_result$eig[2, 2]))
ggsave(file.path(out_fig, "FigA2_factormap_pub.png"), p_cluster,
width = 10, height = 8, dpi = 300)
cat(">>> Guardado en:", file.path(out_fig, "FigA2_factormap_pub.png"), "\n")
# Silhouette plot
png(file.path(out_fig, "FigA3_silhouette.png"), width = 2400, height = 1600, res = 200)
plot(sil, col = c("#1b9e77", "#d95f02", "#7570b3"),
main = "Silhouette plot (3 clusters, k=5 neighbors)")
dev.off()
cat(">>> Guardado en:", file.path(out_fig, "FigA3_silhouette.png"), "\n")
# --- 1.11 Correlaciones entre exposiciones ---
cat("\n--- CORRELACIONES ENTRE EXPOSICIONES ---\n")
cor_matrix <- cor(df_complete[, vars_exposure], use = "complete.obs")
print(round(cor_matrix, 4))
write.csv(round(cor_matrix, 4), file.path(out_tab, "AppendixA_exposure_correlations.csv"))
# =============================================================
# PARTE 2: ROBUSTNESS - ÍNDICES k=3 y k=10
# =============================================================
cat("\n\n")
cat("================================================================\n")
cat("  PARTE 2: ROBUSTNESS CHECKS (k=3, k=10)\n")
cat("================================================================\n\n")
# --- 2.1 Identificar variables GPS ---
# En tu código, las GPS son a19_1.x (lat) y a19_2.x (lon)
# En el .dta de Stata, los puntos se reemplazan por _
# Buscar las variables correctas
gps_candidates <- grep("a19_1|a19_2|latit|longit", names(df), value = TRUE, ignore.case = TRUE)
cat("Variables GPS candidatas encontradas:\n")
print(gps_candidates)
# Intentar detectar automáticamente
lat_var <- NULL
lon_var <- NULL
for (v in gps_candidates) {
vals <- suppressWarnings(as.numeric(df[[v]]))
vals <- vals[!is.na(vals) & vals != 0]
if (length(vals) > 100) {
med <- median(vals, na.rm = TRUE)
if (med > -10 && med < 15) {  # Colombia latitude range
if (is.null(lat_var)) lat_var <- v
}
if (med < -60 && med > -85) {  # Colombia longitude range
if (is.null(lon_var)) lon_var <- v
}
}
}
if (is.null(lat_var) || is.null(lon_var)) {
# Fallback: usar nombres comunes
if ("a19_1.x" %in% names(df)) { lat_var <- "a19_1.x"; lon_var <- "a19_2.x" }
else if ("a19_1_x" %in% names(df)) { lat_var <- "a19_1_x"; lon_var <- "a19_2_x" }
else if ("a19_1_y" %in% names(df)) { lat_var <- "a19_1_y"; lon_var <- "a19_2_y" }
else stop("No se encontraron variables GPS. Ajustar lat_var y lon_var manualmente.")
}
cat(sprintf("\nUsando: lat = %s, lon = %s\n", lat_var, lon_var))
# --- 2.2 Preparar datos con GPS ---
df$lat <- suppressWarnings(as.numeric(as.character(df[[lat_var]])))
df$lon <- suppressWarnings(as.numeric(as.character(df[[lon_var]])))
df_gps <- df %>%
filter(!is.na(lat) & !is.na(lon) & lat != 0 & lon != 0)
cat(sprintf("Observaciones con GPS válido: %d de %d\n", nrow(df_gps), nrow(df)))
# Variables de adopción
adopt_vars <- c("conser_agua_suelo", "variedad_castillo", "fertilizante_organico")
# Convertir a numérico
for (v in adopt_vars) {
df_gps[[v]] <- suppressWarnings(as.numeric(as.character(df_gps[[v]])))
}
# --- 2.3 Función IDW leave-one-out ---
compute_idw_exposure <- function(data, k) {
coords <- as.matrix(data[, c("lon", "lat")])
knn_result <- get.knnx(coords, coords, k = k + 1)
# Excluir el punto mismo (primer vecino)
idx  <- knn_result$nn.index[, 2:(k + 1)]
dist <- knn_result$nn.dist[, 2:(k + 1)]
n <- nrow(data)
results <- list()
for (av in adopt_vars) {
adoption <- data[[av]]
exposure <- numeric(n)
for (i in 1:n) {
d <- dist[i, ]
d[d == 0] <- 0.0001  # evitar /0
w <- (1 / d) / sum(1 / d)
a <- adoption[idx[i, ]]
valid <- !is.na(a)
if (sum(valid) > 0) {
w_v <- w[valid] / sum(w[valid])
exposure[i] <- sum(w_v * a[valid])
} else {
exposure[i] <- NA
}
}
results[[paste0("exp_k", k, "_", av)]] <- exposure
}
# Distancia promedio a vecinos
results[[paste0("dist_avg_k", k)]] <- apply(dist, 1, mean)
return(as.data.frame(results))
}
# --- 2.4 Calcular para k=3, k=5 (verificación), k=10 ---
k_values <- c(3, 5, 10)
all_exposures <- data.frame(nuevo_id = df_gps$nuevo_id)
for (k in k_values) {
cat(sprintf("\n=== Calculando exposición IDW para k=%d ===\n", k))
exp_k <- compute_idw_exposure(df_gps, k)
all_exposures <- cbind(all_exposures, exp_k)
cat(sprintf("  Completado. %d variables generadas.\n", ncol(exp_k)))
}
# --- 2.5 Estadísticas descriptivas ---
cat("\n=== Estadísticas descriptivas de exposiciones ===\n")
exp_vars <- grep("^exp_k[0-9]+_", names(all_exposures), value = TRUE)
for (v in exp_vars) {
x <- all_exposures[[v]]
cat(sprintf("  %s: mean=%.3f, sd=%.3f, min=%.3f, max=%.3f, N=%d\n",
v, mean(x, na.rm = TRUE), sd(x, na.rm = TRUE),
min(x, na.rm = TRUE), max(x, na.rm = TRUE), sum(!is.na(x))))
}
# --- 2.6 Correlaciones entre k ---
cat("\n=== Correlaciones entre valores de k (estabilidad) ===\n")
for (av in adopt_vars) {
cat(sprintf("\n--- %s ---\n", av))
cols <- paste0("exp_k", k_values, "_", av)
cols_exist <- cols[cols %in% names(all_exposures)]
if (length(cols_exist) > 1) {
cor_mat <- cor(all_exposures[cols_exist], use = "complete.obs")
colnames(cor_mat) <- paste0("k=", k_values[1:ncol(cor_mat)])
rownames(cor_mat) <- paste0("k=", k_values[1:nrow(cor_mat)])
print(round(cor_mat, 3))
}
}
# --- 2.7 Distancias promedio ---
cat("\n=== Distancias promedio a vecinos (en grados) ===\n")
for (k in k_values) {
d <- all_exposures[[paste0("dist_avg_k", k)]]
# Conversión aproximada: 1 grado ≈ 111 km en Ecuador, ~100 km en Colombia
cat(sprintf("  k=%d: mean=%.4f grados (≈ %.1f km), sd=%.4f, max=%.4f (≈ %.1f km)\n",
k, mean(d, na.rm = TRUE), mean(d, na.rm = TRUE) * 100,
sd(d, na.rm = TRUE),
max(d, na.rm = TRUE), max(d, na.rm = TRUE) * 100))
}
# --- 2.8 Reconstruir clusters para k=3 y k=10 ---
cat("\n=== Reconstruyendo clusters MFA/HCPC para k=3 y k=10 ===\n")
for (k in c(3, 10)) {
cat(sprintf("\n--- k=%d ---\n", k))
# Variables de exposición para este k
exp_k_vars <- paste0("exp_k", k, "_", adopt_vars)
# Verificar que las variables existen en all_exposures
cat(sprintf("  Variables buscadas: %s\n", paste(exp_k_vars, collapse = ", ")))
missing_vars <- exp_k_vars[!exp_k_vars %in% names(all_exposures)]
if (length(missing_vars) > 0) {
cat(sprintf("  ERROR: Variables no encontradas en all_exposures: %s\n",
paste(missing_vars, collapse = ", ")))
cat(sprintf("  Variables disponibles: %s\n",
paste(grep(paste0("k", k), names(all_exposures), value = TRUE), collapse = ", ")))
next
}
# Merge con df_gps (usar solo nuevo_id y las variables de este k)
cols_to_merge <- c("nuevo_id", exp_k_vars)
df_k <- df_gps %>%
left_join(all_exposures[, cols_to_merge, drop = FALSE], by = "nuevo_id") %>%
drop_na(all_of(exp_k_vars))
cat(sprintf("  N con datos completos: %d\n", nrow(df_k)))
# PCA
pca_k <- PCA(df_k[, exp_k_vars], scale.unit = TRUE, ncp = 3, graph = FALSE)
cat("  Eigenvalues:\n")
print(round(pca_k$eig, 3))
# HCPC con 3 clusters
hcpc_k <- HCPC(pca_k, nb.clust = 3, graph = FALSE)
cat("  Distribución de clusters:\n")
print(table(hcpc_k$data.clust$clust))
# Guardar asignación de clusters
clust_name <- paste0("clust_k", k)
df_k[[clust_name]] <- as.integer(hcpc_k$data.clust$clust)
# Medias de exposición por cluster
cat("  Medias de exposición por cluster:\n")
means_k <- df_k %>%
group_by(!!sym(clust_name)) %>%
summarise(across(all_of(exp_k_vars), ~ round(mean(.x, na.rm = TRUE), 3)),
N = n(), .groups = "drop")
print(as.data.frame(means_k))
# Silhouette
sil_k <- silhouette(as.integer(hcpc_k$data.clust$clust), dist(pca_k$ind$coord))
cat(sprintf("  Average silhouette width: %.4f\n", mean(sil_k[, "sil_width"])))
# Exportar clusters para merge en Stata
export_k <- df_k[, c("nuevo_id", clust_name)]
write_dta(export_k, file.path(proc_dir, sprintf("clusters_k%d.dta", k)))
cat(sprintf("  >>> Exportado: %s\n", file.path(proc_dir, sprintf("clusters_k%d.dta", k))))
}
# --- 2.9 Exportar todas las exposiciones ---
write_dta(all_exposures, file.path(proc_dir, "exposure_indices_k3_k5_k10.dta"))
write.csv(all_exposures, file.path(proc_dir, "exposure_indices_k3_k5_k10.csv"), row.names = FALSE)
cat(sprintf("\n>>> Exposiciones guardadas: %s\n", file.path(proc_dir, "exposure_indices_k3_k5_k10.dta")))
# =============================================================
# RESUMEN FINAL
# =============================================================
cat("\n\n")
cat("================================================================\n")
cat("  RESUMEN: ARCHIVOS GENERADOS\n")
cat("================================================================\n")
cat("\nPara Appendix A:\n")
cat(sprintf("  Tablas:  %s/AppendixA_eigenvalues.csv\n", out_tab))
cat(sprintf("  Tablas:  %s/AppendixA_cluster_validation.csv\n", out_tab))
cat(sprintf("  Tablas:  %s/AppendixA_exposure_correlations.csv\n", out_tab))
cat(sprintf("  Figuras: %s/FigA1_dendrogram.png\n", out_fig))
cat(sprintf("  Figuras: %s/FigA2_factormap_pub.png\n", out_fig))
cat(sprintf("  Figuras: %s/FigA3_silhouette.png\n", out_fig))
cat("\nPara Robustness (k=3, k=10):\n")
cat(sprintf("  Datos:   %s/exposure_indices_k3_k5_k10.dta\n", proc_dir))
cat(sprintf("  Datos:   %s/clusters_k3.dta\n", proc_dir))
cat(sprintf("  Datos:   %s/clusters_k10.dta\n", proc_dir))
cat("\nSiguientes pasos en Stata:\n")
cat("  1. merge 1:1 nuevo_id using clusters_k3.dta, keep(master match) nogen\n")
cat("  2. merge 1:1 nuevo_id using clusters_k10.dta, keep(master match) nogen\n")
cat("  3. Crear dummies: tab clust_k3, gen(cl_k3_) y tab clust_k10, gen(cl_k10_)\n")
cat("  4. Correr MVP con cl_k3_2 cl_k3_3 y cl_k10_2 cl_k10_3\n")
cat("================================================================\n")
