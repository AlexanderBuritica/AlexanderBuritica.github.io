# =============================================================================
# BA2 – Estadística para la Toma de Decisiones
# Clase 12 · CLASE FINAL – Guía práctica en R
# Tema: Regresión Lineal Simple – 6 casos del mundo real
# Instructor: Alexander Buriticá Casanova · Business Analytics 2026-1
# =============================================================================
# Paquetes: install.packages(c("ggplot2","dplyr","broom","lmtest"))
# Ejecuta sección por sección con Ctrl+Enter
# =============================================================================
library(ggplot2); library(dplyr); library(broom)
set.seed(2026)
# ─── Función reutilizable: análisis completo de regresión ───────────────────
analizar_regresion <- function(datos, x_col, y_col, titulo,
x_lab="X", y_lab="Y", pred_x=NULL,
color_pts="#2C3E8C", color_line="tomato") {
cat("\n", rep("═",65), "\n")
cat(" REGRESIÓN:", titulo, "\n")
cat(rep("═",65), "\n")
fmla <- as.formula(paste(y_col, "~", x_col))
mod  <- lm(fmla, data=datos)
sm   <- summary(mod)
# Coeficientes e interpretación
b0  <- round(coef(mod)[1], 4)
b1  <- round(coef(mod)[2], 4)
r2  <- round(sm$r.squared, 4)
p_b1<- sm$coefficients[2,4]
cat("\nEcuación estimada:\n")
cat(sprintf("  ŷ = %.4f + %.4f × %s\n", b0, b1, x_col))
cat(sprintf("\nInterpretación de β₁:\n"))
cat(sprintf("  Por cada unidad adicional de %s, %s cambia en %.4f unidades.\n", x_col, y_col, b1))
cat(sprintf("  Dirección: %s\n", ifelse(b1>0,"POSITIVA (relación directa)","NEGATIVA (relación inversa)")))
cat(sprintf("\nBondad de ajuste:\n"))
cat(sprintf("  R² = %.4f → el modelo explica el %.1f%% de la variación en %s.\n", r2, r2*100, y_col))
cat(sprintf("  Magnitud: %s\n",
ifelse(r2<0.25,"Débil",ifelse(r2<0.50,"Moderado",ifelse(r2<0.75,"Bueno","Excelente")))))
cat(sprintf("\nSignificancia de β₁:\n"))
cat(sprintf("  t = %.3f  |  p-value = %s\n",
sm$coefficients[2,3], format(p_b1, scientific=TRUE)))
cat(sprintf("  Decisión: %s\n",
ifelse(p_b1<0.05,"RECHAZAR H₀ → β₁ ≠ 0 → regresión significativa al 5%",
"No rechazar H₀ → sin evidencia de relación lineal")))
# Predicción si se proporciona un valor de X
if(!is.null(pred_x)) {
yhat <- b0 + b1 * pred_x
cat(sprintf("\nPredicción:\n"))
cat(sprintf("  Para %s = %s: ŷ = %.4f + %.4f × %s = %.4f\n",
x_col, pred_x, b0, b1, pred_x, yhat))
}
cat(sprintf("\n  Reporte académico:\n  '%s (b₁=%.4f, SE=%.4f, t(%.0f)=%.3f, p%s, R²=%.3f)'\n",
titulo, b1, sm$coefficients[2,2],
sm$df[2], sm$coefficients[2,3],
ifelse(p_b1<0.001,"<0.001",paste0("=",round(p_b1,4))),
r2))
# Gráfico
df_plot <- datos
df_plot$x_var <- datos[[x_col]]
df_plot$y_var <- datos[[y_col]]
df_plot$fitted <- fitted(mod)
df_plot$residual <- residuals(mod)
p <- ggplot(df_plot, aes(x=x_var, y=y_var)) +
geom_point(color=color_pts, alpha=0.75, size=2) +
geom_smooth(method="lm", color=color_line, se=TRUE, linewidth=1.2,
fill=color_line, alpha=0.12) +
labs(
title=titulo,
subtitle=sprintf("ŷ = %.3f + %.4f×%s  |  R²=%.3f  |  p%s",
b0, b1, x_col,r2,ifelse(p_b1<0.001,"<0.001",paste0("=",round(p_b1,4)))),
x=x_lab, y=y_lab
) +
theme_minimal(base_size=13)
print(p)
return(invisible(mod))
}
cat("\n\n🏠 CASO 1: PRECIOS DE APARTAMENTOS EN BOGOTÁ\n")
aptos <- data.frame(
area   = c(35,42,48,55,58,65,70,72,80,85,90,95,100,110,120,130,140,150,
38,52,68,74,88,92,105,115,125,135),
precio = NA_real_
)
aptos$precio <- round(120 + 1.8*aptos$area + rnorm(nrow(aptos),0,22), 1)
mod1 <- analizar_regresion(aptos, "area", "precio",
"Área (m²) → Precio apartamento Bogotá (M COP)",
x_lab="Área (m²)", y_lab="Precio (millones COP)",
pred_x=85, color_pts="#2C3E8C", color_line="tomato")
mod1 <- analizar_regresion(aptos, "area", "precio",
"Área (m²) → Precio apartamento Bogotá (M COP)",
x_lab="Área (m²)", y_lab="Precio (millones COP)",
pred_x=95, color_pts="#2C3E8C", color_line="tomato")
mod1 <- analizar_regresion(aptos, "area", "precio",
"Área (m²) → Precio apartamento Bogotá (M COP)",
x_lab="Área (m²)", y_lab="Precio (millones COP)",
pred_x=85, color_pts="#2C3E8C", color_line="tomato")
cat("\nAnálisis de residuos – casos específicos:\n")
aptos$pred  <- fitted(mod1)
aptos$resid <- residuals(mod1)
cat("Aptos con mayor residuo positivo (sobrevaluados):\n")
print(head(aptos[order(-aptos$resid), c("area","precio","pred","resid")], 3))
cat("\nAptos con mayor residuo negativo (subvaluados - oportunidad):\n")
print(head(aptos[order(aptos$resid),  c("area","precio","pred","resid")], 3))
