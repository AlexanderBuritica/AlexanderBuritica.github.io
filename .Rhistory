# =====================================================================
# 7. TABLAS DESCRIPTIVAS DE ADOPCIÓN
# =====================================================================
indices  <- c("i1_intens","i2_manejo","i3_agro","i4_lp")
etiq_ind <- c(
i1_intens = "Intensificación productiva",
i2_manejo = "Manejo agronómico",
i3_agro   = "Agroforestería y conservación",
i4_lp     = "Inversiones de largo plazo"
)
# Tabla 1: Tasa de adopción por índice y departamento
tab_adopcion <- map_dfr(indices, function(ind) {
col_p <- paste0(ind, "_prop")
col_a <- paste0(ind, "_adopta")
base_analisis %>%
group_by(depto) %>%
summarise(
indice     = etiq_ind[ind],
n          = n(),
prop_med   = round(mean(.data[[col_p]], na.rm=TRUE)*100, 1),
pct_adopta = round(mean(.data[[col_a]], na.rm=TRUE)*100, 1),
.groups    = "drop"
)
}) %>% arrange(depto, indice)
cat("\n=== Adopción de prácticas por departamento ===\n"); print(tab_adopcion)
tab_viol <- map_dfr(indices, function(ind) {
col_p <- paste0(ind, "_prop")
base_analisis %>%
filter(!is.na(viol_cat)) %>%
group_by(depto, viol_cat) %>%
summarise(
indice   = etiq_ind[ind],
n        = n(),
prop_med = round(mean(.data[[col_p]], na.rm=TRUE)*100, 1),
.groups  = "drop"
)
}) %>% arrange(depto, indice, viol_cat)
cat("\n=== Adopción por violencia municipal ===\n"); print(tab_viol, n=60)
if (any(!is.na(base_analisis$aptitud))) {
tab_apt <- map_dfr(indices, function(ind) {
col_p <- paste0(ind, "_prop")
base_analisis %>%
filter(!is.na(aptitud)) %>%
group_by(depto, aptitud) %>%
summarise(indice   = etiq_ind[ind], n = n(),
prop_med = round(mean(.data[[col_p]], na.rm=TRUE)*100, 1),
.groups  = "drop")
}) %>% arrange(depto, indice, aptitud)
cat("\n=== Adopción por aptitud ===\n"); print(tab_apt, n=80)
} else {
tab_apt <- tibble()
message("Sin datos de aptitud en encuesta.")
}
# Tabla 4: Correlación entre índices
mat_cor <- base_analisis %>%
select(ends_with("_prop")) %>%
rename_with(~ str_remove(.x, "_prop")) %>%
cor(use = "pairwise.complete.obs") %>%
round(3)
cat("\n=== Correlación entre índices ===\n"); print(mat_cor)
# =====================================================================
# 8. REGRESIONES EXPLORATORIAS: PRÁCTICA ~ VIOLENCIA (OLS)
#    Para el paper usar modelos más robustos (IV, probit, panel).
# =====================================================================
regresiones <- map_dfr(indices, function(ind) {
col_p <- paste0(ind, "_prop")
df_r  <- base_analisis %>%
filter(!is.na(.data[[col_p]]), !is.na(viol_total_hist)) %>%
mutate(lv     = log1p(viol_total_hist),
lv5km  = log1p(viol_5km_hist),
depto_f = factor(depto))
m1 <- lm(as.formula(paste0(col_p," ~ lv + depto_f")),    data = df_r)
m2 <- lm(as.formula(paste0(col_p," ~ lv5km + depto_f")), data = df_r)
bind_rows(
tidy(m1) %>% mutate(indice=etiq_ind[ind], modelo="OLS_muni"),
tidy(m2) %>% mutate(indice=etiq_ind[ind], modelo="OLS_5km")
) %>%
filter(str_detect(term, "^lv")) %>%
select(indice, modelo, term, estimate, std.error, statistic, p.value)
})
cat("\n=== Efecto de violencia sobre adopción (OLS) ===\n")
print(regresiones %>% mutate(across(where(is.numeric), ~ round(.x,4))), n=40)
# G1: Barras adopción por índice y nivel de violencia
g1_dat <- map_dfr(indices, function(ind) {
col_p <- paste0(ind, "_prop")
base_analisis %>%
filter(!is.na(viol_cat)) %>%
group_by(depto, viol_cat) %>%
summarise(prop = mean(.data[[col_p]], na.rm=TRUE),
n    = sum(!is.na(.data[[col_p]])),
se   = sd(.data[[col_p]], na.rm=TRUE) / sqrt(n),
.groups = "drop") %>%
mutate(indice = etiq_ind[ind])
})
g1 <- ggplot(g1_dat, aes(x=viol_cat, y=prop*100, fill=viol_cat,
ymin=(prop-se)*100, ymax=(prop+se)*100)) +
geom_col(width=0.65, show.legend=FALSE) +
geom_errorbar(width=0.2, linewidth=0.5) +
geom_text(aes(label=paste0(round(prop*100,0),"%"), y=(prop+se)*100+1.5),
size=2.8, color="grey30") +
scale_fill_manual(values=c("Baja"="#fee8c8","Media"="#fc8d59","Alta"="#7f0000")) +
scale_y_continuous(labels=label_percent(scale=1), expand=expansion(mult=c(0,.12))) +
facet_grid(indice ~ depto, scales="free_y") +
labs(title="Tasa de adopción de prácticas según violencia municipal",
subtitle="Media ± error estándar | Violencia: terciles históricos",
x="Violencia histórica (tercil)", y="Proporción de prácticas adoptadas (%)") +
theme_minimal(base_size=10) +
theme(strip.text=element_text(face="bold",size=8),
plot.title=element_text(face="bold",hjust=0.5),
panel.grid.major.x=element_blank())
print(g1)
# G2: Boxplot distribución por violencia
g2_dat <- map_dfr(indices, function(ind) {
col_p <- paste0(ind, "_prop")
base_analisis %>% filter(!is.na(viol_cat)) %>%
transmute(depto, viol_cat, prop=.data[[col_p]]*100, indice=etiq_ind[ind])
})
g2 <- ggplot(g2_dat, aes(x=viol_cat, y=prop, fill=viol_cat)) +
geom_boxplot(outlier.size=0.4, outlier.alpha=0.3, width=0.55) +
geom_jitter(width=0.12, size=0.3, alpha=0.2, color="grey30") +
scale_fill_manual(values=c("Baja"="#fee8c8","Media"="#fc8d59","Alta"="#7f0000"),
guide="none") +
scale_y_continuous(labels=label_percent(scale=1)) +
facet_grid(indice ~ depto, scales="free_y") +
labs(title="Distribución de prácticas adoptadas por nivel de violencia",
x="Violencia histórica (tercil)", y="% prácticas adoptadas en el índice") +
theme_minimal(base_size=10) +
theme(strip.text=element_text(face="bold",size=8),
plot.title=element_text(face="bold",hjust=0.5))
print(g2)
ggsave(file.path(ruta_fig,"fig_practicas_boxplot_violencia.png"), g2, width=11, height=10, dpi=180)
# G3: Forest plot coeficientes OLS
g3_dat <- regresiones %>%
mutate(
sig     = case_when(p.value < .01 ~ "***", p.value < .05 ~ "**",
p.value < .10 ~ "*",   TRUE ~ ""),
modelo  = recode(modelo,
"OLS_muni" = "Violencia municipal (log)",
"OLS_5km"  = "Violencia 5 km buffer (log)"),
sig_col = ifelse(p.value < .10, "Sig. (p<0.10)", "No sig.")
)
g3 <- ggplot(g3_dat, aes(x=estimate, y=fct_reorder(indice,estimate),
color=sig_col, shape=modelo)) +
geom_vline(xintercept=0, linetype="dashed", color="grey50") +
geom_errorbarh(aes(xmin=estimate-1.96*std.error,
xmax=estimate+1.96*std.error), height=0.15) +
geom_point(size=3) +
geom_text(aes(label=sig, x=estimate+1.96*std.error+0.002), vjust=-0.5, size=3.5) +
scale_color_manual(values=c("Sig. (p<0.10)"="#c00","No sig."="grey60")) +
scale_shape_manual(values=c(16,17)) +
labs(title="Efecto de la violencia sobre la adopción de prácticas agrícolas",
subtitle="OLS con efectos fijos de departamento | IC 95%",
x="Coeficiente (β) — cambio en prop. de prácticas adoptadas",
y=NULL, color="Significancia", shape="Medida de violencia") +
theme_minimal(base_size=11) +
theme(legend.position="bottom", plot.title=element_text(face="bold",hjust=0.5))
print(g3)
ggsave(file.path(ruta_fig,"fig_practicas_forest_violencia.png"), g3, width=10, height=5, dpi=180)
# G4: Heatmap adopción por aptitud × violencia
if (any(!is.na(base_analisis$aptitud))) {
g4_dat <- map_dfr(indices, function(ind) {
col_p <- paste0(ind, "_prop")
base_analisis %>%
filter(!is.na(aptitud), !is.na(viol_cat)) %>%
group_by(aptitud, viol_cat) %>%
summarise(prop=mean(.data[[col_p]],na.rm=TRUE)*100, n=n(), .groups="drop") %>%
mutate(indice=etiq_ind[ind])
})
g4 <- ggplot(g4_dat, aes(x=viol_cat, y=aptitud, fill=prop)) +
geom_tile(color="white", linewidth=0.7) +
geom_text(aes(label=paste0(round(prop,0),"%\n(n=",n,")")), size=2.8, color="black") +
scale_fill_distiller(palette="Blues", direction=1, name="% prácticas\nadoptadas") +
facet_wrap(~indice, ncol=2) +
labs(title="Adopción de prácticas: aptitud del suelo × nivel de violencia",
x="Violencia histórica (tercil)", y="Aptitud para cacao") +
theme_minimal(base_size=10) +
theme(strip.text=element_text(face="bold",size=8),
plot.title=element_text(face="bold",hjust=0.5),
panel.grid=element_blank())
print(g4)
ggsave(file.path(ruta_fig,"fig_practicas_heatmap_apt_viol.png"), g4, width=12, height=8, dpi=180)
}
# G5: Scatter rendimiento ~ índice I4 por violencia
if (any(!is.na(base_analisis$cacaoyielddrykgha))) {
g5_dat <- base_analisis %>%
filter(!is.na(cacaoyielddrykgha), !is.na(i4_lp_prop))
g5 <- ggplot(g5_dat, aes(x=i4_lp_prop*100, y=cacaoyielddrykgha, color=viol_cat)) +
geom_point(size=0.9, alpha=0.45) +
geom_smooth(method="lm", se=TRUE, linewidth=0.8, alpha=0.12) +
scale_color_manual(values=c("Baja"="#fee8c8","Media"="#fc8d59","Alta"="#7f0000"),
na.value="grey70", name="Violencia (tercil)") +
scale_y_continuous(labels=comma) +
facet_wrap(~depto, scales="free") +
labs(title="Rendimiento y prácticas de largo plazo, según violencia",
subtitle="Índice I4: agroforestería, riego, renovación",
x="Prácticas de largo plazo adoptadas (%)",
y="Rendimiento cacao (kg/ha, peso seco)") +
theme_minimal(base_size=11) +
theme(plot.title=element_text(face="bold",hjust=0.5))
print(g5)
ggsave(file.path(ruta_fig,"fig_rend_practicasLP_violencia.png"), g5, width=11, height=5, dpi=180)
}
cols_indice <- c(paste0(indices,"_suma"), paste0(indices,"_prop"), paste0(indices,"_adopta"))
cols_export <- c("cedula","cod_dep_enc","depto","cod_mun_enc","nom_mun",
"viol_total_hist","viol_5a","viol_5km_hist","viol_10km_hist",
"viol_cat","aptitud","cacaoyielddrykgha",
cols_indice[cols_indice %in% names(base_analisis)])
write_xlsx(
list(
"Base_practicas"      = as.data.frame(base_analisis %>% select(any_of(cols_export))),
"Adopcion_x_depto"    = as.data.frame(tab_adopcion),
"Adopcion_x_viol"     = as.data.frame(tab_viol),
"Adopcion_x_aptitud"  = as.data.frame(tab_apt),
"Regresiones_OLS"     = as.data.frame(regresiones),
"Diagnostico_vars"    = as.data.frame(df_vars),
"Correlacion_indices" = as.data.frame(
as.data.frame(mat_cor) %>% tibble::rownames_to_column("indice"))
),
path = file.path(ruta_fig, "practicas_indice_violencia_aptitud.xlsx")
)
message("\nListo. Archivos en:\n  ", ruta_fig)
message("Tras correr: revisa 'diagnostico_variables_fincas.xlsx' y ajusta",
" los vectores de variables en Sección 3 si faltan prácticas.")
